# Test image for lab-in-a-box's automated checks (tests/run_tests.sh).
# Deliberately NOT run with --systemd — see webui_service_test.sh: running
# plain (no /run/systemd/system) exercises the installer's non-systemd
# fallback path for _webui_mode=service, which is otherwise easy to leave
# untested on any dev machine that does have systemd (this project's own
# convention: never rely on the host having any particular init system).
FROM registry.opensuse.org/opensuse/leap:15.6
RUN zypper --non-interactive install --no-recommends \
        bash python3 python3-xml python311-base systemd git tar xz curl iproute2 nodejs22 \
    && zypper clean --all \
    && ln -sf /usr/bin/node22 /usr/local/bin/node 2>/dev/null || ln -sf /usr/bin/node /usr/local/bin/node 2>/dev/null || true
WORKDIR /repo
