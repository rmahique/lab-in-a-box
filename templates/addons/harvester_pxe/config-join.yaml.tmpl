# See config-create.yaml.tmpl's header — same scheme, "join" mode, same
# optional passthrough blocks (system_settings/os/install extras).
scheme_version: 1
server_url: https://${harvester_vip}:443
token: "${harvester_token}"
${harvester_system_settings_block}os:
  hostname: ${node_hostname}
  ssh_authorized_keys:
${harvester_ssh_keys_block}
  password: "${harvester_password_hash}"
  ntp_servers:
${harvester_ntp_servers_block}
  dns_nameservers:
${harvester_dns_nameservers_block}
${harvester_os_extra_lines}install:
  mode: join
  management_interface:
    interfaces:
      - name: ${harvester_iface}
    default_route: true
    method: static
    ip: ${node_ip}
    subnetmask: ${harvester_netmask}
    gateway: ${harvester_gateway}
  device: ${harvester_device}
  iso_url: ${harvester_iso_url}
  persistentpartitionsize: ${harvester_persistent_size}
${harvester_install_extra_lines}