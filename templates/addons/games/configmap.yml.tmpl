---
apiVersion: v1
kind: ConfigMap
metadata:
  name: games-arcade-html
  namespace: ${games_ns:-games}
data:
  index.html: |
    <!doctype html>
    <html lang="en">
    <head>
    <meta charset="utf-8">
    <title>lab-in-a-box arcade</title>
    <style>
      body { background: #14171c; color: #e8e8e8; font-family: sans-serif; margin: 0; padding: 2rem; }
      h1 { color: #7fd1ae; }
      p.intro { color: #9aa3ad; max-width: 42rem; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; margin-top: 2rem; }
      a.card { display: block; background: #1f242c; border: 1px solid #2c333d; border-radius: 10px; padding: 1.2rem; color: #e8e8e8; text-decoration: none; }
      a.card:hover { border-color: #7fd1ae; }
      a.card .name { font-weight: bold; font-size: 1.1rem; }
      a.card .desc { color: #9aa3ad; font-size: 0.9rem; margin-top: 0.4rem; }
      footer { margin-top: 3rem; color: #5a6672; }
      footer a { color: #7fd1ae; }
    </style>
    </head>
    <body>
    <h1>lab-in-a-box arcade</h1>
    <p class="intro">A curated shortlist of open-source, browser-playable games, each linking out to
    its own real itch.io page (nothing here is self-hosted or redistributed) - deployed by this
    project's "games" addon as a small, fun demo workload.</p>
    <div class="grid">
      <a class="card" href="https://alzter-s.itch.io/supertux-classic" target="_blank" rel="noopener">
        <div class="name">SuperTux Classic</div>
        <div class="desc">A GPL-licensed 2D platformer remaster - a penguin in Antarctica.</div>
      </a>
      <a class="card" href="https://tinytakinteller.itch.io/the-best-game-ever" target="_blank" rel="noopener">
        <div class="name">A Dark Forest</div>
        <div class="desc">An incremental, minimalistic idle game inspired by A Dark Room.</div>
      </a>
      <a class="card" href="https://escada-games.itch.io/starcatcher" target="_blank" rel="noopener">
        <div class="name">Starcatcher</div>
        <div class="desc">A one-button space platformer - collect the stars.</div>
      </a>
      <a class="card" href="https://edisgreat.itch.io/skynet-simulator" target="_blank" rel="noopener">
        <div class="name">Skynet Simulator</div>
        <div class="desc">MIT-licensed puzzle/idle game - play as Skynet taking over a sandbox.</div>
      </a>
      <a class="card" href="https://leandrodreamer.itch.io/open-saber" target="_blank" rel="noopener">
        <div class="name">Open Saber</div>
        <div class="desc">An open-source rhythmic block-cutting game, playable in the browser.</div>
      </a>
    </div>
    <footer>Served by lab-in-a-box's own "games" addon. See <a href="https://itch.io/games/html5/tag-open-source">itch.io's own open-source HTML5 tag</a> for more.</footer>
    </body>
    </html>
...
