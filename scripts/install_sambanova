#!/usr/bin/env python3.11
# Part of lab-in-a-box, it will install a SambaNova Cloud proxy (LiteLLM)
# Author/s: Raul Mahiques
# License: GPLv3
#
# Schema version: 1.1
#
# JSON section: "sambanova" — SambaNova Cloud API proxy (LiteLLM), on a kcluster or as a podman container on a node
#   sambanova_api_key    : [MANDATORY] SambaNova Cloud API key (from https://cloud.sambanova.ai)
#   sambanova_model      : [MANDATORY] the model to serve, written the way LiteLLM routes it, normally
#                              "sambanova/<model-id>". It is named rather than defaulted on purpose: a model id this
#                              project guessed would fail at the provider long after this add-on reported
#                              success. Confirm the route and the id at https://docs.litellm.ai/docs/providers
#   sambanova_api_base   : [OPTIONAL] endpoint to use instead of the one the route implies, for an
#                              OpenAI-compatible URL this provider publishes or a regional endpoint
#   sambanova_version    : [OPTIONAL] litellm-helm chart version (empty = latest)
#   sambanova_chart      : [OPTIONAL] litellm-helm chart (default: oci://ghcr.io/berriai/litellm-helm)
#   sambanova_ns         : [OPTIONAL] namespace (default: sambanova)
#   sambanova_shorthn    : [OPTIONAL] hostname prefix (default: sambanova)
#   sambanova_deployment : [OPTIONAL] how it is installed. Unset follows where the lab places it: "kubernetes"
#                          when a kcluster lists "sambanova" in its addons[], "podman" when only a node does
#                          (options: podman, kubernetes)
#   sambanova_image      : [OPTIONAL] LiteLLM container image, in podman mode (default: ghcr.io/berriai/litellm)
#   sambanova_image_tag  : [OPTIONAL] tag of that image, in podman mode (default: main-stable)
#   sambanova_port       : [OPTIONAL] host port the proxy answers on, in podman mode (default: 4020)
#
# In podman mode the proxy answers at http://<node>:<sambanova_port>/v1 on every node that lists "sambanova" in
# its own addons[], and its master key is in /etc/litellm/sambanova/env there (libs/litellm_common.py). The
# chart, namespace and hostname fields apply in kubernetes mode.
#
# Same shape as the anthropic, openai, gemini and kimi add-ons: LiteLLM in front of one hosted model,
# reached by any OpenAI client at http://sambanova.<kcluster>.<domain>/v1. The provider's key
# and the proxy's own master key live in Secrets, and the install itself is
# libs/litellm_common.py's install_provider(), so this script only names its provider.

__version__ = "__LABVERSION__"

PROVIDER = "sambanova"

PLUGIN = {
    "name": "sambanova",
    # kubernetes mode is the litellm-helm chart on a kcluster, podman mode one container on a node.
    "targets": ["container", "vm", "baremetal"],
    "layers": ["kubernetes", "standalone-container"],
    "requires_kubernetes": None,
    # The chart's values turn an ingress on, which is how the endpoint is reached.
    "requires_cluster": ["ingress"],
    "aux_services": [],
}

import sys
from pathlib import Path

for _candidate in ("/usr/local/lib/lab_creation", str(Path(__file__).resolve().parent.parent / "libs")):
    if Path(_candidate).is_dir() and _candidate not in sys.path:
        sys.path.insert(0, _candidate)

import addon_common as ac  # noqa: E402
import litellm_common  # noqa: E402
import primary  # noqa: E402


def _validate(v):
    litellm_common.validate_provider(v, PROVIDER)


def main():
    ac.handle_common_args(__file__, __version__, validate_fn=_validate, plugin=PLUGIN)

    if len(sys.argv) < 2:
        print("Usage: {} <lab-file>".format(Path(sys.argv[0]).name))
        sys.exit(1)
    litellm_common.install_provider(primary.load_definition(sys.argv[1]), PROVIDER)


if __name__ == "__main__":
    main()
