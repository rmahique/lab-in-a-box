#
# This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for more details.
#
# You should have received a copy of the GNU General Public License along with this program. If not, see <https://www.gnu.org/licenses/gpl-3.0.html>.
#
# JSON section: "stackpack" — configurable keys:
#   stackpack_api_key         : [MANDATORY] StackState API key for this cluster
#   stackpack_url             : [MANDATORY] StackState receiver URL
#                               (e.g. https://stackstate.mydemo.lab:8080/receiver/sinks/topology)
#   stackpack_cluster_name    : [OPTIONAL] name reported to StackState (default: clu_name from cluster)
#   stackpack_version         : [OPTIONAL] Helm chart version (empty = latest, e.g. "1.0.8")
#   stackpack_ns              : [OPTIONAL] namespace (default: stackstate)
#   stackpack_rel             : [OPTIONAL] Helm repo alias (default: stackstate)
#   stackpack_repo_url        : [OPTIONAL] Helm repo URL (default: https://helm.stackstate.io)


_VERSION="__LABVERSION__"
[[ "${1}" == "--version" || "${1}" == "-v" ]] && echo "${0##*/} ${_VERSION}" && exit 0
if [[ "${1}" == "--validate" ]]; then
    _vf="${2}" _ve=0
    _vreq() { local _v; _v=$(jq -r ".${1}.${2} // \"\""  < "${_vf}" 2>/dev/null); [[ -n "${_v}" ]] || { echo "[ERROR] ${1}.${2} is required (no default)"; ((_ve++)); }; }
    _vns()  { local _v; _v=$(jq -r ".${1}.${1}_ns // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[a-z0-9][a-z0-9-]{0,62}$' || { echo "[ERROR] ${1}.${1}_ns='${_v}': invalid namespace (lowercase, alphanumeric, hyphens only)"; ((_ve++)); }; }
    _vver() { local _v; _v=$(jq -r ".${1}.${1}_version // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+\.[0-9]' || { echo "[ERROR] ${1}.${1}_version='${_v}': not a valid version (expected X.Y…)"; ((_ve++)); }; }
    _vurl() { local _v; _v=$(jq -r ".${1}.${1}_repo_url // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^https?://' || { echo "[ERROR] ${1}.${1}_repo_url='${_v}': must start with https://"; ((_ve++)); }; }
    _vbool(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" || "${_v}" == "true" || "${_v}" == "false" ]] || { echo "[ERROR] ${1}.${2}='${_v}': must be 'true' or 'false'"; ((_ve++)); }; }
    _vport(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+$' || { echo "[ERROR] ${1}.${2}='${_v}': must be a port number"; ((_ve++)); }; }
    _vreq stackpack stackpack_api_key
    _vreq stackpack stackpack_url
    _vns stackpack; _vver stackpack
    exit ${_ve}
fi

if [[ "${1}" == "--help" ]]; then
    echo "Usage: ${0##*/} <lab.json> [<vm_name>]"
    echo ""
    awk '/# (─+ *)?JSON section:/{p=1} p && /^[^#]/{exit} p{sub(/^# ?/,""); print}' "$0"
    exit 0
fi
if [[ "${1}" == "--input-definition" || "${1}" == "--schema" ]]; then
    lab_schema "$0" "${2:-json}"
    exit $?
fi


# load lab_creation defaults
if [[ -f /etc/lab_creation.defaults ]]
then
        . /etc/lab_creation.defaults
elif [[ -f lab_creation.defaults ]]
then
        . lab_creation.defaults
else
        echo "ERROR: Configuration file lab_creation.defaults not found in local path or /etc"
        exit 1
fi

# Load primary functions
. ${_primary_funtions} || exit 1

# load Kubernetes functions
. ${_lib_path}/k8s_functions.bash


# Setup StackState Helm repo
function setup_stackpack_repo() {
        _repo_name="${stackpack_rel:-stackstate}"
        _repo_url="${stackpack_repo_url:-https://helm.stackstate.io}"
        helm_repo_add
}

# Install StackState Kubernetes Agent
function setup_stackpack() {
        if [[ -z "${stackpack_api_key}" ]]
        then
                echo "ERROR: stackpack_api_key is mandatory. Set it in the JSON 'stackpack' section." >&2
                exit 1
        fi
        if [[ -z "${stackpack_url}" ]]
        then
                echo "ERROR: stackpack_url is mandatory. Set it in the JSON 'stackpack' section." >&2
                exit 1
        fi

        _ver="${stackpack_version:+--version ${stackpack_version}}"
        _cluster="${stackpack_cluster_name:-${clu_name}}"

        $ssh_command "helm upgrade -i stackstate-k8s-agent ${stackpack_rel:-stackstate}/stackstate-k8s-agent \
                --namespace ${stackpack_ns:-stackstate} \
                --create-namespace \
                --set-string global.receiverApiKey=${stackpack_api_key} \
                --set-string global.stackstate.url=${stackpack_url} \
                --set-string global.cluster.name=${_cluster} \
                ${_ver}"
        echo "StackState K8s Agent installed. Namespace: ${stackpack_ns:-stackstate}"
        echo "Reporting cluster '${_cluster}' to: ${stackpack_url}"
}


# load cluster and product vars
load_kclu_vars
load_stackpack_vars

on_first_server setup_helm setup_stackpack_repo setup_stackpack
