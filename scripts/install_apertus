#!/usr/bin/env python3.11
# Part of lab-in-a-box, it will deploy Apertus (Swiss AI Initiative's open LLM) via Ollama
# Author/s: Raul Mahiques
# License: GPLv3
#
# Schema version: 1.3
#
# JSON section: "apertus" — Apertus (Swiss AI Initiative) model, served via Ollama, on a kcluster or in a node's own podman Ollama
#   apertus_deployment : [OPTIONAL] how it is installed. Unset follows where the lab places it: "kubernetes" when
#                       a kcluster lists "apertus" in its addons[], "podman" when only a node does
#                       (options: podman, kubernetes)
#   apertus_tag         : [OPTIONAL] Ollama model tag; the default is a ~5.1GB quantized build, practical
#                         for lab hardware (default: 8b-instruct-2509-q4_k_m)
#                         Other options: 8b-instruct-2509-bf16 (~16GB, full precision), 70b-instruct-
#                         2509-q4_k_m (~44GB), 70b-instruct-2509-bf16 (~141GB, needs serious hardware)
#   apertus_ns          : [OPTIONAL] Ollama namespace to pull into (default: ollama)
#   apertus_shorthn     : [OPTIONAL] hostname prefix if Ollama is not yet installed (default: ollama)
#   apertus_rel         : [OPTIONAL] Helm repo alias (default: ollama-helm)
#   apertus_repo_url    : [OPTIONAL] Helm repo URL (default: https://otwld.github.io/ollama-helm/)
#   apertus_version     : [OPTIONAL] Helm chart version (empty = latest)
#
# The model goes into the kcluster's one Ollama, the Helm release "ollama" shared with the ollama add-on and
# the other model add-ons (libs/ollama_common.py), which pulls every model they ask for. Its namespace, chart
# and hostname are the ollama add-on's when the kcluster lists it, else this section's own apertus_ns,
# apertus_shorthn, apertus_rel, apertus_repo_url and apertus_version.
#
# In podman mode the model goes into the node's own Ollama container instead, the ollama add-on's
# (libs/ollama_common.py), which this add-on starts from the ollama section when it is not running yet.
# The namespace, hostname and chart fields above apply in kubernetes mode only.
#
# This script installs Ollama (if not present) and pulls the configured Apertus model — same shape as
# the "deepseek" addon.
#
# Apertus is a fully-open (weights + training data + training code) LLM from the Swiss AI Initiative
# (ETH Zurich, EPFL, and the Swiss National Supercomputing Centre). Licensed under Apache
# 2.0. Unlike deepseek/llama/qwen/mistral, it is NOT in Ollama's own officially-curated library — the
# GGUF build pulled here is a COMMUNITY package (MichelRosselli/apertus on ollama.com), maintained by a
# third party, not the Apertus team or Ollama itself. The Ollama client must be 0.12.6 or newer for Apertus'
# architecture to load. If the pull fails with an unrecognized-architecture error, update Ollama first.

__version__ = "__LABVERSION__"

PLUGIN = {
    "name": "apertus",
    # kubernetes mode pulls into the kcluster's Ollama release, podman mode into a node's Ollama container
    # (libs/ollama_common.py's run() dispatches between them).
    "targets": ["container", "vm", "baremetal"],
    "layers": ["kubernetes", "standalone-container"],
    "requires_kubernetes": None,
    "requires_cluster": ["ingress"],
    "aux_services": [],
}

import sys
from pathlib import Path

for _candidate in ("/usr/local/lib/lab_creation", str(Path(__file__).resolve().parent.parent / "libs")):
    if Path(_candidate).is_dir() and _candidate not in sys.path:
        sys.path.insert(0, _candidate)

import addon_common as ac  # noqa: E402
import ollama_common  # noqa: E402
import primary  # noqa: E402


def _validate(v):
    v.vns("apertus")
    v.vver("apertus")
    ollama_common.validate_podman(v, "apertus")


def main():
    ac.handle_common_args(__file__, __version__, validate_fn=_validate, plugin=PLUGIN)

    if len(sys.argv) < 2:
        print("Usage: {} <lab-file>".format(Path(sys.argv[0]).name))
        sys.exit(1)
    ollama_common.run(primary.load_definition(sys.argv[1]), "apertus")
    print("Community GGUF package (not Ollama's own curated library, not the Apertus team): "
          "verify licensing and provenance before relying on it beyond a lab demo.")


if __name__ == "__main__":
    main()
