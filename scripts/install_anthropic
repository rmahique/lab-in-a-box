#!/usr/bin/env python3.11
# Part of lab-in-a-box, it will install an Anthropic Claude AI proxy (LiteLLM)
# Author/s: Raul Mahiques
# License: GPLv3
#
# Schema version: 2.2
#
# JSON section: "anthropic" — Anthropic Claude API proxy (LiteLLM), on a kcluster or as a podman container on a node
#   anthropic_api_key   : [MANDATORY] Anthropic API key (from https://console.anthropic.com)
#   anthropic_model     : [OPTIONAL] default Claude model (default: anthropic/claude-sonnet-5)
#                         Examples: anthropic/claude-opus-5, anthropic/claude-haiku-4-5
#   anthropic_version   : [OPTIONAL] litellm-helm chart version (empty = latest)
#   anthropic_chart     : [OPTIONAL] litellm-helm chart (default: oci://ghcr.io/berriai/litellm-helm)
#   anthropic_ns        : [OPTIONAL] namespace (default: anthropic)
#   anthropic_shorthn   : [OPTIONAL] hostname prefix (default: anthropic)
#   anthropic_deployment : [OPTIONAL] how it is installed. Unset follows where the lab places it: "kubernetes"
#                          when a kcluster lists "anthropic" in its addons[], "podman" when only a node does
#                          (options: podman, kubernetes)
#   anthropic_image      : [OPTIONAL] LiteLLM container image, in podman mode (default: ghcr.io/berriai/litellm)
#   anthropic_image_tag  : [OPTIONAL] tag of that image, in podman mode (default: main-stable)
#   anthropic_port       : [OPTIONAL] host port the proxy answers on, in podman mode (default: 4000)
#
# In podman mode the proxy answers at http://<node>:<anthropic_port>/v1 on every node that lists "anthropic" in
# its own addons[], and its master key is in /etc/litellm/anthropic/env there (libs/litellm_common.py). The
# chart, namespace and hostname fields apply in kubernetes mode.
#
# Same shape as the "gemini" addon: deploys LiteLLM as an OpenAI-compatible proxy, this time in front
# of Anthropic's own API. Any OpenAI SDK/client can reach Claude models through the resulting endpoint.

__version__ = "__LABVERSION__"

PLUGIN = {
    "name": "anthropic",
    # kubernetes mode is the litellm-helm chart on a kcluster, podman mode one container on a node.
    "targets": ["container", "vm", "baremetal"],
    "layers": ["kubernetes", "standalone-container"],
    "requires_kubernetes": None,
    "aux_services": [],
}

import sys
from pathlib import Path

for _candidate in ("/usr/local/lib/lab_creation", str(Path(__file__).resolve().parent.parent / "libs")):
    if Path(_candidate).is_dir() and _candidate not in sys.path:
        sys.path.insert(0, _candidate)

import addon_common as ac  # noqa: E402
import primary  # noqa: E402
import k8s  # noqa: E402
import litellm_common  # noqa: E402
import placement  # noqa: E402
from lab_creation import setup_helm  # noqa: E402


def _validate(v):
    v.vreq("anthropic", "anthropic_api_key")
    v.vns("anthropic")
    v.vver("anthropic")
    litellm_common.validate_podman(v, "anthropic")


def setup_anthropic(hostname: str, clu_name: str, mydomain: str, cfg: dict) -> str:
    """Install the LiteLLM proxy in front of the configured model; returns the endpoint hostname."""
    ns = cfg.get("anthropic_ns") or "anthropic"
    fqdn = "{}.{}.{}".format(cfg.get("anthropic_shorthn") or "anthropic", clu_name, mydomain)
    litellm_common.setup_litellm_proxy(hostname, "anthropic-proxy", ns, fqdn, "claude", cfg.get("anthropic_model") or "anthropic/claude-sonnet-5",
                                       cfg["anthropic_api_key"], chart=cfg.get("anthropic_chart") or "",
                                       version=cfg.get("anthropic_version") or "")
    return fqdn


def main():
    ac.handle_common_args(__file__, __version__, validate_fn=_validate, plugin=PLUGIN)

    if len(sys.argv) < 2:
        print("Usage: {} <lab-file>".format(Path(sys.argv[0]).name))
        sys.exit(1)
    lab_file = sys.argv[1]
    definition = primary.load_definition(lab_file)
    cfg = definition.get("anthropic", {}) or {}
    if placement.deployment(definition, "anthropic", cfg) != placement.KUBERNETES:
        litellm_common.install_podman_nodes(definition, "anthropic", "claude",
                                            default_model="anthropic/claude-sonnet-5")
        return

    target = k8s.first_server_node(definition)
    if not target:
        sys.exit(1)
    vm_name, _ssh_cmd = target

    clu_name = k8s.get_vm_kcluster(definition, vm_name)
    clu_cfg = k8s.load_kclu_vars(definition, clu_name) if clu_name else {}
    if not cfg.get("anthropic_api_key"):
        print("ERROR: anthropic.anthropic_api_key is mandatory.", file=sys.stderr)
        sys.exit(1)

    setup_helm(vm_name, clu_name, online=definition.get("common", {}).get("online") == "1")
    fqdn = setup_anthropic(vm_name, clu_name, clu_cfg.get("mydomain", ""), cfg)
    ac.register_service_dns(definition, clu_name, fqdn)


if __name__ == "__main__":
    main()
