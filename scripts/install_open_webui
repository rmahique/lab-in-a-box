#!/usr/bin/env python3.11
# Part of lab-in-a-box, it will install Open WebUI (chat frontend for Ollama/OpenAI-compatible APIs)
# Author/s: Raul Mahiques
# License: GPLv3
#
# Schema version: 2.2
#
# JSON section: "open_webui" — Chat frontend for Ollama / OpenAI-compatible endpoints, on a kcluster or with podman
#   open_webui_deployment      : [OPTIONAL] how it is installed. Unset follows where the lab places it:
#                                 "kubernetes" when a kcluster lists "open_webui" in its addons[], "podman" when
#                                 only a node does (options: podman, kubernetes)
#   open_webui_version         : [OPTIONAL] Helm chart version (empty = latest)
#   open_webui_ns              : [OPTIONAL] namespace (default: open-webui)
#   open_webui_source : [OPTIONAL] where the chart comes from:
#                         "appcollection" (the default: open-webui from the SUSE Application
#                         Collection, oci://dp.apps.rancher.io/charts/open-webui), or "upstream"
#                         for the project's own chart, which needs no account.
#                         "appcollection" needs an Application Collection user and token:
#                         open_webui_appcollection_user/open_webui_appcollection_password, or
#                         open_webui_appcollection_account naming a credential file of kind
#                         "appcollection" (one such file in the store is found on its own).
#   open_webui_appcollection_user     : [OPTIONAL] Application Collection user
#   open_webui_appcollection_password : [OPTIONAL] Application Collection access token
#   open_webui_appcollection_account  : [OPTIONAL] name of an "appcollection" credential file
#   open_webui_shorthn         : [OPTIONAL] hostname prefix (default: openwebui)
#   open_webui_rel             : [OPTIONAL] Helm repo alias (default: open-webui)
#   open_webui_repo_url        : [OPTIONAL] Helm repo URL (default: https://helm.openwebui.com/)
#   open_webui_ollama_url      : [OPTIONAL] Ollama endpoint to attach. Unset, it is this lab's own Ollama, the
#                                 one the ollama add-on or a model add-on served through it (codellama,
#                                 starcoder2, deepseek, qwen, mistral, apertus) installs: on this kcluster,
#                                 http://ollama.<namespace>.svc.cluster.local:11434; on a node with podman,
#                                 http://<node>:<ollama_port>, that node first when Open WebUI runs there too;
#                                 on a kcluster seen from a podman Open WebUI, its ingress hostname. Set it for an
#                                 Ollama outside this lab. With neither, the chart's own bundled Ollama subchart
#                                 is used in kubernetes mode, and no Ollama at all in podman mode.
#   open_webui_openai_base_urls : [OPTIONAL] space-separated list of extra OpenAI-compatible endpoints
#                                 to attach as additional model providers (e.g. this lab's own
#                                 "gemini"/"kimi"/"anthropic"/"openai" LiteLLM-proxy addons' FQDNs, so
#                                 they all show up as selectable models in one chat UI)
#   open_webui_openai_api_keys : [OPTIONAL] matching space-separated list of API keys, same order/count
#                                 as open_webui_openai_base_urls (each proxy addon in this project
#                                 accepts any bearer token, so "sk-anything" works unless the proxy was
#                                 configured with LiteLLM's own key enforcement)
#   open_webui_searxng_url     : [OPTIONAL] SearXNG instance to use as the web-search backend, which turns web
#                                 search on. Unset, it is where this lab's own searxng add-on runs:
#                                 http://searxng.<searxng_ns>.svc.cluster.local:<searxng_port>/search?q=<query>
#                                 when a kcluster lists it, http://<node>:<searxng_port>/search?q=<query> when
#                                 only a node lists it (podman), and its ingress hostname when a podman Open WebUI
#                                 reaches one on a kcluster. Set it for an instance outside this lab. The
#                                 instance must serve the json format, which the searxng add-on's own default does
#   open_webui_image           : [OPTIONAL] container image, in podman mode (default: ghcr.io/open-webui/open-webui)
#   open_webui_image_tag       : [OPTIONAL] tag of that image, in podman mode (default: main)
#   open_webui_port            : [OPTIONAL] host port the UI answers on, in podman mode (default: 3000)
#   open_webui_data_dir        : [OPTIONAL] host directory holding the users, chats and settings, in podman
#                                 mode, so a new container keeps them (default: /var/lib/open-webui)
#
# In podman mode Open WebUI runs as one container on every node that lists "open_webui" in its own addons[],
# at http://<node>:<open_webui_port>/, with the OpenAI-compatible keys in the root-only /etc/open-webui/env
# there. The chart, namespace, hostname and Application Collection fields apply in kubernetes mode.
#
# The chart's PVCs need a StorageClass. requires_cluster below ("storageclass") makes
# cluster_plan() (libs/k8s.py) add one automatically on a distribution that doesn't bundle its own
# (e.g. a bare RKE2 cluster) — default "longhorn", override with the kcluster's own clu_storage
# (e.g. "local-path" for a single-node cluster). Found live 2026-11-05: this field was missing here,
# so a bare RKE2 cluster's pods stayed Pending with no error in this addon's own output at all.

__version__ = "__LABVERSION__"

APPCOLLECTION_CHART = "open-webui"
APPCOLLECTION_PREFIX = "open_webui"

PLUGIN = {
    "name": "open_webui",
    # kubernetes mode is the chart on a kcluster, podman mode one container on a node.
    "targets": ["container", "vm", "baremetal"],
    "layers": ["kubernetes", "standalone-container"],
    "requires_kubernetes": None,
    "requires_cluster": ["ingress", "storageclass"],
    "aux_services": [],
}

import shlex
import sys
from pathlib import Path

for _candidate in ("/usr/local/lib/lab_creation", str(Path(__file__).resolve().parent.parent / "libs")):
    if Path(_candidate).is_dir() and _candidate not in sys.path:
        sys.path.insert(0, _candidate)

import addon_common as ac  # noqa: E402
import primary  # noqa: E402
import k8s  # noqa: E402
import ollama_common  # noqa: E402
import placement  # noqa: E402
import podman_service as ps  # noqa: E402
from lab_creation import setup_helm, helm_repo_add, ssh_run, die  # noqa: E402
import appco_common as appco  # noqa: E402

_DEFAULT_IMAGE = "ghcr.io/open-webui/open-webui"
_DEFAULT_IMAGE_TAG = "main"
_DEFAULT_PORT = 3000
_DEFAULT_DATA_DIR = "/var/lib/open-webui"
_CONTAINER = "open-webui"
_ENV_FILE = "/etc/open-webui/env"
# The port and the data directory inside the image, and how long a first start (it fetches its own embedding
# model) gets to answer.
_CONTAINER_PORT = 8080
_CONTAINER_DATA = "/app/backend/data"
_START_WAIT = 600


def _validate(v):
    cfg = v.definition.get("open_webui", {}) or {}
    source = str(cfg.get("open_webui_source") or appco.SOURCE_APPCOLLECTION).strip().lower()
    if source not in appco.SOURCES:
        v.errors.append("[ERROR] open_webui.open_webui_source '{}' is invalid — use one of: {}".format(
            source, ", ".join(appco.SOURCES)))
    elif source == appco.SOURCE_APPCOLLECTION and placement.location(v.definition, "open_webui")[0] == \
            placement.KUBERNETES:
        v.vreq_or_credential("open_webui", "open_webui_appcollection_user", "appcollection",
                             account_field="open_webui_appcollection_account")
        v.vreq_or_credential("open_webui", "open_webui_appcollection_password", "appcollection",
                             account_field="open_webui_appcollection_account")
    v.vns("open_webui")
    v.vver("open_webui")
    placement.validate(v, "open_webui")
    v.vport("open_webui", "open_webui_port")


def setup_open_webui_repo(hostname, open_webui_rel=None, open_webui_repo_url=None):
    """Add the Open WebUI Helm repo."""
    helm_repo_add(hostname, open_webui_rel or "open-webui", open_webui_repo_url or "https://helm.openwebui.com/")


def searxng_query_url(definition, open_webui_searxng_url=None, outside_cluster=False):
    """
    The SEARXNG_QUERY_URL for Open WebUI's web search: the field when the lab sets one, else where this lab's own
    searxng add-on runs (on a kcluster its in-cluster Service, or its ingress hostname for an Open WebUI
    `outside_cluster`; with podman its node's own name and port), else "" (web search stays off).
    """
    if open_webui_searxng_url:
        return str(open_webui_searxng_url)
    mode, place = placement.location(definition, "searxng")
    if mode == placement.KUBERNETES:
        cfg = definition.get("searxng") or {}
        if outside_cluster:
            domain = ((definition.get("kclusters") or {}).get(place) or {}).get("mydomain")
            host = ".".join(p for p in (cfg.get("searxng_shorthn") or "searxng", place, domain) if p)
            return "http://{}/search?q=<query>".format(host)
        return "http://searxng.{}.svc.cluster.local:{}/search?q=<query>".format(
            cfg.get("searxng_ns") or "searxng", cfg.get("searxng_port") or "8080")
    if mode == placement.PODMAN:
        cfg = k8s.addon_node_config(definition, "searxng", place)
        return placement.node_url(place, cfg.get("searxng_port") or "8080", "/search?q=<query>")
    return ""


def setup_open_webui(hostname, clu_name, mydomain, definition, open_webui_rel=None, open_webui_ns=None,
                      open_webui_version=None, open_webui_shorthn=None, open_webui_ollama_url=None,
                      open_webui_openai_base_urls=None, open_webui_openai_api_keys=None,
                      open_webui_searxng_url=None, extra_set=""):
    """Install Open WebUI, wired to this lab's own Ollama/LiteLLM-proxy/SearXNG addons where present."""
    rel = open_webui_rel or "open-webui"
    ns = open_webui_ns or "open-webui"
    ver_arg = "--version {}".format(shlex.quote(open_webui_version)) if open_webui_version else ""
    fqdn = "{}.{}.{}".format(open_webui_shorthn or "openwebui", clu_name, mydomain)

    ollama_url = (open_webui_ollama_url or ollama_common.service_url(definition, clu_name)
                  or ollama_common.podman_url_for(definition))

    set_args = [
        "--set ingress.enabled=true",
        "--set ingress.host={}".format(shlex.quote(fqdn)),
    ]
    if ollama_url:
        set_args.append("--set ollamaUrls[0]={}".format(shlex.quote(ollama_url)))

    base_urls = (open_webui_openai_base_urls or "").split()
    api_keys = (open_webui_openai_api_keys or "").split()
    for i, url in enumerate(base_urls):
        set_args.append("--set openaiBaseApiUrls[{}]={}".format(i, shlex.quote(url)))
        key = api_keys[i] if i < len(api_keys) else "sk-anything"
        set_args.append("--set openaiApiKeys[{}]={}".format(i, shlex.quote(key)))
    if base_urls:
        set_args.append("--set enableOpenaiApi=true")

    searxng_url = searxng_query_url(definition, open_webui_searxng_url)
    if searxng_url:
        for i, (name, value) in enumerate((("ENABLE_WEB_SEARCH", "true"), ("WEB_SEARCH_ENGINE", "searxng"),
                                           ("SEARXNG_QUERY_URL", searxng_url))):
            set_args.append("--set extraEnvVars[{}].name={}".format(i, name))
            set_args.append("--set extraEnvVars[{}].value={}".format(i, shlex.quote(value)))

    ssh_run(hostname,
            "helm upgrade -i open-webui {}/open-webui --namespace {} --create-namespace {} "
            "{}{}".format(rel, ns, " ".join(set_args), ver_arg, extra_set))

    print("Open WebUI installed. Namespace: {}".format(ns))
    print("Chat UI available at: http://{}".format(fqdn))
    if ollama_url:
        print("Attached Ollama endpoint: {}".format(ollama_url))
    if base_urls:
        print("Attached OpenAI-compatible endpoint(s): {}".format(", ".join(base_urls)))
    if searxng_url:
        print("Web search enabled, through SearXNG at: {}".format(searxng_url))
    if not ollama_url and not base_urls:
        print("No ollama/OpenAI-compatible endpoint configured — using the chart's own bundled Ollama subchart default.")
    return fqdn


def podman_env(definition, cfg, hostname):
    """
    The environment of the podman-mode container: Ollama, the OpenAI-compatible endpoints and their keys, and web
    search, found as in kubernetes mode but from outside any cluster (see the field descriptions).
    """
    env = {}
    ollama_url = (cfg.get("open_webui_ollama_url") or ollama_common.podman_url_for(definition, prefer=hostname)
                  or ollama_common.ingress_url(definition))
    if ollama_url:
        env["OLLAMA_BASE_URL"] = str(ollama_url)
    base_urls = str(cfg.get("open_webui_openai_base_urls") or "").split()
    if base_urls:
        env["OPENAI_API_BASE_URLS"] = ";".join(base_urls)
        env["OPENAI_API_KEYS"] = ";".join(str(cfg.get("open_webui_openai_api_keys") or "").split())
    searxng_url = searxng_query_url(definition, cfg.get("open_webui_searxng_url"), outside_cluster=True)
    if searxng_url:
        env.update({"ENABLE_WEB_SEARCH": "true", "WEB_SEARCH_ENGINE": "searxng", "SEARXNG_QUERY_URL": searxng_url})
    return env


def setup_open_webui_podman(hostname, definition, cfg):
    """Run Open WebUI as a podman container on `hostname` from the section `cfg`; returns the URL it answers on."""
    port = int(cfg.get("open_webui_port") or _DEFAULT_PORT)
    data_dir = str(cfg.get("open_webui_data_dir") or _DEFAULT_DATA_DIR)
    image = "{}:{}".format(cfg.get("open_webui_image") or _DEFAULT_IMAGE,
                           cfg.get("open_webui_image_tag") or _DEFAULT_IMAGE_TAG)
    env = podman_env(definition, cfg, hostname)
    ps.write_env_file(hostname, _ENV_FILE, env)
    ssh_run(hostname, "mkdir -p {}".format(shlex.quote(data_dir)))
    ps.deploy(hostname, _CONTAINER, image, description="Open WebUI (lab-in-a-box)",
              ports=["{}:{}".format(port, _CONTAINER_PORT)], env_file=_ENV_FILE,
              volumes=["{}:{}:Z".format(data_dir, _CONTAINER_DATA)])
    ps.wait_for_http(hostname, "http://127.0.0.1:{}/health".format(port), timeout=_START_WAIT, what="Open WebUI")
    url = placement.node_url(hostname, port, "/")
    print("Chat UI available at: {}".format(url))
    if env.get("OLLAMA_BASE_URL"):
        print("Attached Ollama endpoint: {}".format(env["OLLAMA_BASE_URL"]))
    if env.get("SEARXNG_QUERY_URL"):
        print("Web search enabled, through SearXNG at: {}".format(env["SEARXNG_QUERY_URL"]))
    print("The node itself must allow traffic on port {}: this add-on manages no firewall or security group".format(
        port))
    return url


def main():
    ac.handle_common_args(__file__, __version__, validate_fn=_validate, plugin=PLUGIN)

    if len(sys.argv) < 2:
        print("Usage: {} <lab-file>".format(Path(sys.argv[0]).name))
        sys.exit(1)
    lab_file = sys.argv[1]
    definition = primary.load_definition(lab_file)
    if placement.deployment(definition, "open_webui", definition.get("open_webui") or {}) != placement.KUBERNETES:
        for vm_name in placement.podman_nodes(definition, "open_webui"):
            setup_open_webui_podman(vm_name, definition, k8s.addon_node_config(definition, "open_webui", vm_name))
        return

    target = k8s.first_server_node(definition)
    if not target:
        sys.exit(1)
    vm_name, _ssh_cmd = target

    clu_name = k8s.get_vm_kcluster(definition, vm_name)
    clu_cfg = k8s.load_kclu_vars(definition, clu_name) if clu_name else {}
    cfg = definition.get("open_webui", {}) or {}
    online = definition.get("common", {}).get("online") == "1"

    setup_helm(vm_name, clu_name, online=online)
    repo, extra_set = "", ""
    if appco.from_appcollection(cfg, "open_webui", appco.SOURCE_APPCOLLECTION):
        user, password = appco.credentials(cfg, APPCOLLECTION_PREFIX)
        if not user or not password:
            die("open_webui: open_webui_source is \"appcollection\", so open_webui_appcollection_user and "
                "open_webui_appcollection_password are needed — set them, set open_webui_appcollection_account "
                "to an \"appcollection\" credential file, or leave all three unset with exactly "
                "one such file in the store (https://apps.rancher.io)")
        repo, extra_set = appco.prepare_appcollection_repo(
            vm_name, cfg.get("open_webui_ns") or "open-webui", user, password)
    else:
        setup_open_webui_repo(vm_name, open_webui_rel=cfg.get("open_webui_rel"),
                               open_webui_repo_url=cfg.get("open_webui_repo_url"))
    fqdn = setup_open_webui(vm_name, clu_name, clu_cfg.get("mydomain"), definition,
                             open_webui_rel=repo or cfg.get("open_webui_rel"),
                             open_webui_ns=cfg.get("open_webui_ns"),
                             open_webui_version=cfg.get("open_webui_version"),
                             open_webui_shorthn=cfg.get("open_webui_shorthn"),
                             open_webui_ollama_url=cfg.get("open_webui_ollama_url"),
                             open_webui_openai_base_urls=cfg.get("open_webui_openai_base_urls"),
                             open_webui_openai_api_keys=cfg.get("open_webui_openai_api_keys"),
                             open_webui_searxng_url=cfg.get("open_webui_searxng_url"),
                             extra_set=extra_set)
    ac.register_service_dns(definition, clu_name, fqdn)


if __name__ == "__main__":
    main()
