#!/usr/bin/env python3.11
# Part of lab-in-a-box, it will self-host Skynet Simulator (an open-source browser puzzle/idle game)
# Author/s: Raul Mahiques
# License: GPLv3
#
# Project: https://github.com/edisgreat/skynet-simulator, also listed at
# https://edisgreat.itch.io/skynet-simulator
#
# Schema version: 1.2
#
# JSON section: "skynet_simulator" — Skynet Simulator, a self-hosted browser puzzle game, on a kcluster or with podman
#   skynet_simulator_deployment : [OPTIONAL] how it is installed. Unset follows where the lab places it:
#                                 "kubernetes" when a kcluster lists "skynet_simulator" in its addons[], "podman"
#                                 when only a node does (options: podman, kubernetes)
#   skynet_simulator_ns      : [OPTIONAL] namespace, in kubernetes mode (default: skynet-simulator)
#   skynet_simulator_shorthn : [OPTIONAL] hostname prefix for ingress, in kubernetes mode
#                              (default: skynet-simulator)
#   skynet_simulator_port    : [OPTIONAL] host port the game is served on, in podman mode (default: 8090)
#
# LICENSE: MIT. Self-hosting the game is permitted.
#
# This deploys the game's own real files directly from its git repository (a plain static HTML/
# CSS/JS app with index.html, css/ and script/ at the repo root and no build step) via a
# Kubernetes initContainer that downloads the repo's own GitHub archive tarball and extracts it
# into a shared volume; an ordinary nginx container serves it. The repo also ships a small optional
# PHP/MySQL logging feature (update.php/log.sql) — deliberately NOT wired up here (no PHP/DB
# runtime in this addon's nginx-only pod); the game itself works fully without it.
#
# In podman mode the same fetch script runs once in a throwaway container on every node that lists
# "skynet_simulator" in its own addons[], into /var/lib/skynet-simulator/html, and an nginx container serves it
# at http://<node>:<skynet_simulator_port>/ (libs/static_webgame_common.py's deploy_podman()).

__version__ = "__LABVERSION__"

PLUGIN = {
    "name": "skynet_simulator",
    # kubernetes mode is a Deployment behind an ingress, podman mode an nginx container on a node.
    "targets": ["container", "vm", "baremetal"],
    "layers": ["kubernetes", "standalone-container"],
    "requires_kubernetes": None,
    "aux_services": [],
}

import sys
from pathlib import Path

for _candidate in ("/usr/local/lib/lab_creation", str(Path(__file__).resolve().parent.parent / "libs")):
    if Path(_candidate).is_dir() and _candidate not in sys.path:
        sys.path.insert(0, _candidate)

import addon_common as ac  # noqa: E402
import primary  # noqa: E402
import k8s  # noqa: E402
import placement  # noqa: E402
import static_webgame_common  # noqa: E402
from lab_creation import ssh_run  # noqa: E402

_FETCH_SCRIPT = """
set -e
apk add --no-cache curl tar >/tmp/fetch.log 2>&1
curl -fsSL "https://github.com/edisgreat/skynet-simulator/archive/refs/heads/master.tar.gz" -o /tmp/g.tar.gz
mkdir -p /tmp/extract
tar -xzf /tmp/g.tar.gz -C /tmp/extract
cp -a /tmp/extract/*/. /shared/
rm -rf /tmp/g.tar.gz /tmp/extract
""".strip()
DEFAULT_PORT = 8090


def _validate(v):
    v.vns("skynet_simulator")
    placement.validate(v, "skynet_simulator")
    v.vport("skynet_simulator", "skynet_simulator_port")


def setup_skynet_simulator(hostname, clu_name, mydomain, cfg):
    """Self-host Skynet Simulator's real static files."""
    ns = cfg.get("skynet_simulator_ns") or "skynet-simulator"
    shorthn = cfg.get("skynet_simulator_shorthn") or "skynet-simulator"
    host = "{}.{}.{}".format(shorthn, clu_name, mydomain)

    manifest = static_webgame_common.render_static_webgame(
        "skynet-simulator", ns, host, _FETCH_SCRIPT)
    ssh_run(hostname, "kubectl apply -f -", input_text=manifest)

    print("Skynet Simulator deployed. Namespace: {}".format(ns))
    print("Available at: http://{}".format(host))
    return host


def main():
    ac.handle_common_args(__file__, __version__, validate_fn=_validate, plugin=PLUGIN)

    if len(sys.argv) < 2:
        print("Usage: {} <lab-file>".format(Path(sys.argv[0]).name))
        sys.exit(1)
    lab_file = sys.argv[1]
    definition = primary.load_definition(lab_file)
    if placement.deployment(definition, "skynet_simulator",
                            definition.get("skynet_simulator") or {}) != placement.KUBERNETES:
        for vm_name in placement.podman_nodes(definition, "skynet_simulator"):
            cfg = k8s.addon_node_config(definition, "skynet_simulator", vm_name)
            url = static_webgame_common.deploy_podman(vm_name, "skynet-simulator", _FETCH_SCRIPT,
                                                      int(cfg.get("skynet_simulator_port") or DEFAULT_PORT))
            print("Skynet Simulator available at: {}".format(url))
        return

    target = k8s.first_server_node(definition)
    if not target:
        sys.exit(1)
    vm_name, _ssh_cmd = target

    clu_name = k8s.get_vm_kcluster(definition, vm_name)
    clu_cfg = k8s.load_kclu_vars(definition, clu_name) if clu_name else {}
    cfg = definition.get("skynet_simulator", {}) or {}

    host = setup_skynet_simulator(vm_name, clu_name, clu_cfg.get("mydomain"), cfg)
    ac.register_service_dns(definition, clu_name, host)


if __name__ == "__main__":
    main()
