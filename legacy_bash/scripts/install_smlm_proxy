#!/bin/bash
# Part of lab-in-a-box, it will install the SUSE Multi-Linux Manager (SMLM) proxy on Kubernetes
# Author/s: Raul Mahiques
# License: GPLv3
#
#  This program is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, either version 3 of the License, or (at your option) any later version.
#
# This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for more details.
#
# You should have received a copy of the GNU General Public License along with this program. If not, see <https://www.gnu.org/licenses/gpl-3.0.html>.
#
# Reference: https://documentation.suse.com/multi-linux-manager/5.2/en/docs/specialized-guides/kubernetes-guide/proxy-kubernetes-deployment.html
#
# ─── JSON section: "smlm_proxy" ─────────────────────────────────────────────────
#
# MANDATORY
#   smlm_proxy_fqdn         : Fully-qualified domain name for the proxy
#                             (e.g. "proxy.cluster2.mydemo.lab")
#   smlm_proxy_server       : FQDN of the parent SMLM server
#                             (default: "smlm".smlm_fqdn from the same JSON)
#   smlm_proxy_scc_user     : SCC username (default: "smlm".smlm_scc_user)
#   smlm_proxy_scc_password : SCC password (default: "smlm".smlm_scc_password)
#
# OPTIONAL – parent server access (proxy config generation via spacecmd)
#   smlm_proxy_server_node  : SSH host of the Kubernetes node running the SMLM
#                             server (default: same as smlm_proxy_server)
#   smlm_proxy_server_ns    : Namespace of the server deployment (default: uyuni-server)
#   smlm_proxy_admin_user   : SMLM web UI admin user (default: "smlm".smlm_admin_user or admin)
#   smlm_proxy_admin_pass   : SMLM web UI admin pass (default: "smlm".smlm_admin_pass or admin123)
#   smlm_proxy_email        : Proxy administrator email (default: root@<smlm_proxy_fqdn>)
#   smlm_proxy_ssh_port     : SSH port the proxy listens on (default: 8022)
#   smlm_proxy_max_cache    : Maximum squid cache size in MB (default: 2048;
#                             ~60% of the squid volume is a good value)
#
# OPTIONAL – Helm / release
#   smlm_proxy_version      : Helm chart version (empty = latest; while 5.2 has
#                             no GA chart yet set "5.2.0-rc" explicitly)
#   smlm_proxy_ns           : Kubernetes namespace  (default: uyuni-proxy)
#   smlm_proxy_rel          : Helm release name     (default: uyuni-proxy)
#   smlm_proxy_registry     : OCI registry          (default: registry.suse.com)
#   smlm_proxy_chart        : OCI chart path        (default: suse/multi-linux-manager/5.2/proxy-helm)
#   smlm_proxy_img_repository : Image repository base (default: derived from
#                             smlm_proxy_registry/smlm_proxy_chart + '/x86_64')
#   smlm_proxy_img_tag      : Image tag for all images (default: chart default, "latest")
#
# OPTIONAL – networking / ingress
#   smlm_proxy_shorthn      : Short hostname for the DNS entry (default: proxy)
#   smlm_proxy_ingress_class: Ingress class name (default: traefik)
#
# OPTIONAL – storage
#   smlm_proxy_storage_class: StorageClass for the squid cache volume
#                             (empty = cluster default)
#   smlm_proxy_lh_overprovision : Longhorn storage-over-provisioning percentage
#                             set when smlm_proxy_storage_class is "longhorn"
#                             (default: 500)
#
# NOTE: RKE2 (default) or K3s, with Traefik. On RKE2, Traefik is enabled
#       through the 'ingress-controller' option and the extra TCP entrypoints
#       ssh (8022) and salt-publish/salt-request (4505/4506) are exposed via a
#       rke2-traefik HelmChartConfig. On K3s (kclusters clu_type "k3s") the
#       bundled Traefik is reused and the same ports are exposed through its
#       ServiceLB. The proxy must run on a different cluster than the SMLM
#       server (their Traefik port sets differ). TLS uses self-signed lab
#       certificates.



_VERSION="__LABVERSION__"
[[ "${1}" == "--version" || "${1}" == "-v" ]] && echo "${0##*/} ${_VERSION}" && exit 0
if [[ "${1}" == "--validate" ]]; then
    _vf="${2}" _ve=0
    _vreq() { local _v; _v=$(jq -r ".${1}.${2} // \"\""  < "${_vf}" 2>/dev/null); [[ -n "${_v}" ]] || { echo "[ERROR] ${1}.${2} is required (no default)"; ((_ve++)); }; }
    _vns()  { local _v; _v=$(jq -r ".${1}.${1}_ns // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[a-z0-9][a-z0-9-]{0,62}$' || { echo "[ERROR] ${1}.${1}_ns='${_v}': invalid namespace (lowercase, alphanumeric, hyphens only)"; ((_ve++)); }; }
    _vver() { local _v; _v=$(jq -r ".${1}.${1}_version // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+\.[0-9]' || { echo "[ERROR] ${1}.${1}_version='${_v}': not a valid version (expected X.Y…)"; ((_ve++)); }; }
    _vport(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+$' || { echo "[ERROR] ${1}.${2}='${_v}': must be a port number"; ((_ve++)); }; }
    _vfall(){ local _v _f; _v=$(jq -r ".smlm_proxy.${1} // \"\"" < "${_vf}" 2>/dev/null); _f=$(jq -r ".smlm.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -n "${_v}" || -n "${_f}" ]] || { echo "[ERROR] smlm_proxy.${1} is required (and no smlm.${2} fallback found)"; ((_ve++)); }; }
    _vreq smlm_proxy smlm_proxy_fqdn
    _vfall smlm_proxy_server smlm_fqdn
    _vfall smlm_proxy_scc_user smlm_scc_user
    _vfall smlm_proxy_scc_password smlm_scc_password
    _vns smlm_proxy; _vver smlm_proxy
    _vport smlm_proxy smlm_proxy_ssh_port
    _vport smlm_proxy smlm_proxy_max_cache
    exit ${_ve}
fi

if [[ "${1}" == "--help" ]]; then
    echo "Usage: ${0##*/} <lab.json> [<vm_name>]"
    echo ""
    awk '/# (─+ *)?JSON section:/{p=1} p && /^[^#]/{exit} p{sub(/^# ?/,""); print}' "$0"
    exit 0
fi
if [[ "${1}" == "--input-definition" || "${1}" == "--schema" ]]; then
    lab_schema "$0" "${2:-json}"
    exit $?
fi

echo "Starting installation script for the SMLM proxy"


# load lab_creation defaults
if [[ -f /etc/lab_creation.defaults ]]
then
        . /etc/lab_creation.defaults
elif [[ -f lab_creation.defaults ]]
then
        . lab_creation.defaults
else
        echo "ERROR: Configuration file lab_creation.defaults not found in local path or /etc"
        exit 1
fi

# Load primary functions
. ${_primary_funtions} || exit 1

# load Kubernetes functions
. ${_lib_path}/k8s_functions.bash || exit 1


# ─── Traefik configuration ─────────────────────────────────────────────────────
# Exposes the TCP entrypoints the proxy chart routes to (ssh, salt-publish,
# salt-request) via the shared Traefik library functions. The cluster type
# (kclusters clu_type) picks the method: rke2 (default) enables the RKE2
# Traefik ingress; k3s reuses the bundled one.

function setup_smlm_proxy_traefik() {
        if [[ "${clu_type}" == "k3s" ]]
        then
                setup_traefik_k3s ssh:${smlm_proxy_ssh_port:-8022} salt-publish:4505 salt-request:4506
        else
                setup_traefik_rke2 ssh:${smlm_proxy_ssh_port:-8022} salt-publish:4505 salt-request:4506
        fi
}


# ─── Namespace, secrets and certificates ───────────────────────────────────────

function setup_smlm_proxy_prereqs() {
        _ns="${smlm_proxy_ns:-uyuni-proxy}"

        if [[ "${smlm_proxy_storage_class:-}" == "longhorn" ]]
        then
                set_longhorn_overprovisioning "${smlm_proxy_lh_overprovision:-500}"
        fi

        _msg="# Creating namespace and secrets in '${_ns}'" show_nicer_messages

        $ssh_command "kubectl create namespace ${_ns} --dry-run=client -o yaml | kubectl apply -f -"

        # SCC image pull secret (doc: "scc-secret")
        $ssh_command "kubectl create secret docker-registry scc-secret \
                -n ${_ns} \
                --docker-server=${smlm_proxy_registry:-registry.suse.com} \
                --docker-username='${smlm_proxy_scc_user}' \
                --docker-password='${smlm_proxy_scc_password}' \
                --dry-run=client -o yaml | kubectl apply -f -"

        # The no-SSL configuration expects the TLS objects to pre-exist:
        # 'proxy-cert' secret and 'uyuni-ca' configmap (self-signed, lab use)
        _msg="  Generating self-signed TLS certificates" show_nicer_messages
        $ssh_command "
set -e
_fqdn='${smlm_proxy_fqdn}'
_ns='${_ns}'
_tmp=\$(mktemp -d)

openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
    -keyout \${_tmp}/tls.key \
    -out    \${_tmp}/tls.crt \
    -subj \"/CN=\${_fqdn}\" \
    -addext \"subjectAltName=DNS:\${_fqdn}\" 2>/dev/null

kubectl create secret tls proxy-cert -n \${_ns} \
    --cert=\${_tmp}/tls.crt \
    --key=\${_tmp}/tls.key \
    --dry-run=client -o yaml | kubectl apply -f -

kubectl create configmap uyuni-ca -n \${_ns} \
    --from-file=ca.crt=\${_tmp}/tls.crt \
    --dry-run=client -o yaml | kubectl apply -f -

rm -rf \${_tmp}"
}


# ─── Proxy configuration generation (on the parent SMLM server) ────────────────
# The doc generates config.tar.gz with 'spacecmd proxy_container_config_nossl'
# on the server (Option B, recommended for Kubernetes). Our server runs on
# Kubernetes, so the equivalent of 'mgrctl exec' is kubectl exec on the uyuni
# deployment. The tarball is then fetched and extracted on the proxy node.

function generate_smlm_proxy_config() {
        _srv_node="${smlm_proxy_server_node:-${smlm_proxy_server}}"
        _srv_ns="${smlm_proxy_server_ns:-uyuni-server}"
        _srv_ssh="ssh -o StrictHostKeyChecking=accept-new -q root@${_srv_node}"

        _msg="# Generating the proxy configuration on the SMLM server ('${smlm_proxy_server}' via '${_srv_node}')" show_nicer_messages

        ${_srv_ssh} "kubectl exec -n ${_srv_ns} deploy/uyuni -c uyuni -- \
                spacecmd -q -u '${smlm_proxy_admin_user}' -p '${smlm_proxy_admin_pass}' -- \
                'proxy_container_config_nossl -p ${smlm_proxy_ssh_port:-8022} -o /tmp/smlm-proxy-config.tar.gz \
                ${smlm_proxy_fqdn} ${smlm_proxy_server} ${smlm_proxy_max_cache:-2048} ${smlm_proxy_email:-root@${smlm_proxy_fqdn}}'" \
                || _msg="spacecmd failed to generate the proxy configuration on ${_srv_node}" fail_with_error

        # spacecmd can exit 0 on failure — make sure the tarball is really there
        ${_srv_ssh} "kubectl exec -n ${_srv_ns} deploy/uyuni -c uyuni -- test -s /tmp/smlm-proxy-config.tar.gz" \
                || _msg="the proxy configuration tarball was not generated on the server" fail_with_error

        _msg="  Fetching config.tar.gz and extracting it on '${_vm_name}'" show_nicer_messages
        _tmp_cfg=$(mktemp)
        ${_srv_ssh} "kubectl exec -n ${_srv_ns} deploy/uyuni -c uyuni -- cat /tmp/smlm-proxy-config.tar.gz" > "${_tmp_cfg}" \
                || _msg="could not fetch the proxy configuration tarball from the server" fail_with_error
        ${_srv_ssh} "kubectl exec -n ${_srv_ns} deploy/uyuni -c uyuni -- rm -f /tmp/smlm-proxy-config.tar.gz"

        rsync -a "${_tmp_cfg}" root@${_vm_name}:/tmp/smlm-proxy-config.tar.gz \
                || _msg="could not copy the proxy configuration to ${_vm_name}" fail_with_error
        rm -f "${_tmp_cfg}"

        $ssh_command "rm -rf /tmp/smlm-proxy-config && mkdir -p /tmp/smlm-proxy-config && \
                tar -C /tmp/smlm-proxy-config -xzf /tmp/smlm-proxy-config.tar.gz" \
                || _msg="could not extract the proxy configuration tarball" fail_with_error

        # The chart requires all three files (config.yaml, httpd.yaml, ssh.yaml)
        $ssh_command "test -s /tmp/smlm-proxy-config/config.yaml -a \
                -s /tmp/smlm-proxy-config/httpd.yaml -a \
                -s /tmp/smlm-proxy-config/ssh.yaml" \
                || _msg="config.yaml/httpd.yaml/ssh.yaml missing from the generated tarball" fail_with_error
}


# ─── Helm install ──────────────────────────────────────────────────────────────

function setup_smlm_proxy() {
        _ns="${smlm_proxy_ns:-uyuni-proxy}"
        _rel="${smlm_proxy_rel:-uyuni-proxy}"
        _chart="oci://${smlm_proxy_registry:-registry.suse.com}/${smlm_proxy_chart:-suse/multi-linux-manager/5.2/proxy-helm}"
        _ver="${smlm_proxy_version:+--version ${smlm_proxy_version}}"

        _storage_class="${smlm_proxy_storage_class:+--set volumes.squid.storageClass=${smlm_proxy_storage_class}}"

        # The chart's default image repository lacks the arch subpath — the
        # actual images live under …/multi-linux-manager/5.2/x86_64/
        if [[ -n "${smlm_proxy_img_repository}" ]]
        then
                _img_repo="${smlm_proxy_img_repository}"
        else
                _img_repo="${smlm_proxy_registry:-registry.suse.com}/${smlm_proxy_chart:-suse/multi-linux-manager/5.2/proxy-helm}"
                _img_repo="${_img_repo%/proxy-helm}/x86_64"
        fi
        _img_tag="${smlm_proxy_img_tag:+--set tag=${smlm_proxy_img_tag}}"

        _msg="# Installing the SUSE Multi-Linux Manager proxy (${_rel})" show_nicer_messages

        $ssh_command "helm upgrade -i ${_rel} ${_chart} \
                --namespace ${_ns} \
                --create-namespace \
                --set registrySecret=scc-secret \
                --set repository=${_img_repo} \
                --set ingress.class=${smlm_proxy_ingress_class:-traefik} \
                --set-file global.config=/tmp/smlm-proxy-config/config.yaml \
                --set-file global.httpd=/tmp/smlm-proxy-config/httpd.yaml \
                --set-file global.ssh=/tmp/smlm-proxy-config/ssh.yaml \
                ${_storage_class} \
                ${_img_tag} \
                ${_ver}" || _msg="helm install failed for the SMLM proxy" fail_with_error

        $ssh_command "rm -rf /tmp/smlm-proxy-config /tmp/smlm-proxy-config.tar.gz"

        _msg="# Adding DNS entry for the SMLM proxy" show_nicer_messages
        _dns_entry="${smlm_proxy_shorthn:-proxy}.${clu_name}"
        add_service_dns

        _msg="# Waiting for the proxy pods to be ready …" show_nicer_messages
        $ssh_command "kubectl wait pods -n ${_ns} --all \
                --for condition=Ready --timeout=900s 2>/dev/null" || \
        _msg="Pods not fully ready after 15 min — check: kubectl get pods -n ${_ns}" show_nicer_messages

        echo ""
        echo "SUSE Multi-Linux Manager proxy deployed."
        echo "  Proxy FQDN   : ${smlm_proxy_fqdn}"
        echo "  Parent server: ${smlm_proxy_server}"
        echo "  SSH port     : ${smlm_proxy_ssh_port:-8022}"
        echo ""
        echo "  Register clients against the proxy: ${smlm_proxy_fqdn}:4505 / 4506"
}


# ─── Main ──────────────────────────────────────────────────────────────────────

# load cluster and smlm_proxy variables
load_kclu_vars
load_smlm_proxy_vars

# Fall back to the "smlm" section for values shared with the server
# (same-JSON deployments where server and proxy are defined together)
jq -e '.smlm' < "${inputFile}" &>/dev/null && load_smlm_vars
smlm_proxy_server="${smlm_proxy_server:-${smlm_fqdn}}"
smlm_proxy_scc_user="${smlm_proxy_scc_user:-${smlm_scc_user}}"
smlm_proxy_scc_password="${smlm_proxy_scc_password:-${smlm_scc_password}}"
smlm_proxy_admin_user="${smlm_proxy_admin_user:-${smlm_admin_user:-admin}}"
smlm_proxy_admin_pass="${smlm_proxy_admin_pass:-${smlm_admin_pass:-admin123}}"

# Validate mandatory variables
[[ -z "${smlm_proxy_fqdn}" ]]         && { echo "ERROR: smlm_proxy_fqdn is required in the 'smlm_proxy' JSON section" >&2; exit 1; }
[[ -z "${smlm_proxy_server}" ]]       && { echo "ERROR: smlm_proxy_server is required in the 'smlm_proxy' JSON section (or smlm_fqdn in 'smlm')" >&2; exit 1; }
[[ -z "${smlm_proxy_scc_user}" ]]     && { echo "ERROR: smlm_proxy_scc_user is required in the 'smlm_proxy' JSON section (or smlm_scc_user in 'smlm')" >&2; exit 1; }
[[ -z "${smlm_proxy_scc_password}" ]] && { echo "ERROR: smlm_proxy_scc_password is required in the 'smlm_proxy' JSON section (or smlm_scc_password in 'smlm')" >&2; exit 1; }

on_first_server \
        setup_helm \
        setup_smlm_proxy_traefik \
        setup_smlm_proxy_prereqs \
        generate_smlm_proxy_config \
        setup_smlm_proxy
