#!/bin/bash
# Part of lab-in-a-box, it will add the SUSE Application Collection Helm repository
# Author/s: Raul Mahiques
# License: GPLv3
#
#  This program is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, either version 3 of the License, or (at your option) any later version.
#
# This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for more details.
#
# You should have received a copy of the GNU General Public License along with this program. If not, see <https://www.gnu.org/licenses/gpl-3.0.html>.
#
# JSON section: "appcollection" — configurable keys:
#   appcollection_rel       : [OPTIONAL] Helm repo alias (default: suse-application-collection)
#   appcollection_repo_url  : [OPTIONAL] Helm repo URL
#                             (default: https://charts.suse.com/application-collection)
#   appcollection_ns        : [OPTIONAL] default namespace for installs (default: app-collection)
#   appcollection_chart     : [OPTIONAL] specific chart to install from the collection (default: none)
#   appcollection_release   : [OPTIONAL] Helm release name when installing a chart (default: chart name)
#   appcollection_version   : [OPTIONAL] chart version when appcollection_chart is set (empty = latest)
#
# This script adds the SUSE Application Collection repository to Helm and optionally
# installs one specific chart from it. To install multiple charts, call this script
# multiple times with different appcollection_chart values or use 'helm install' directly.


_VERSION="__LABVERSION__"
[[ "${1}" == "--version" || "${1}" == "-v" ]] && echo "${0##*/} ${_VERSION}" && exit 0
if [[ "${1}" == "--validate" ]]; then
    _vf="${2}" _ve=0
    _vreq() { local _v; _v=$(jq -r ".${1}.${2} // \"\""  < "${_vf}" 2>/dev/null); [[ -n "${_v}" ]] || { echo "[ERROR] ${1}.${2} is required (no default)"; ((_ve++)); }; }
    _vns()  { local _v; _v=$(jq -r ".${1}.${1}_ns // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[a-z0-9][a-z0-9-]{0,62}$' || { echo "[ERROR] ${1}.${1}_ns='${_v}': invalid namespace (lowercase, alphanumeric, hyphens only)"; ((_ve++)); }; }
    _vver() { local _v; _v=$(jq -r ".${1}.${1}_version // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+\.[0-9]' || { echo "[ERROR] ${1}.${1}_version='${_v}': not a valid version (expected X.Y…)"; ((_ve++)); }; }
    _vurl() { local _v; _v=$(jq -r ".${1}.${1}_repo_url // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^https?://' || { echo "[ERROR] ${1}.${1}_repo_url='${_v}': must start with https://"; ((_ve++)); }; }
    _vbool(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" || "${_v}" == "true" || "${_v}" == "false" ]] || { echo "[ERROR] ${1}.${2}='${_v}': must be 'true' or 'false'"; ((_ve++)); }; }
    _vport(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+$' || { echo "[ERROR] ${1}.${2}='${_v}': must be a port number"; ((_ve++)); }; }
    _vver appcollection; _vurl appcollection
    exit ${_ve}
fi

if [[ "${1}" == "--help" ]]; then
    echo "Usage: ${0##*/} <lab.json> [<vm_name>]"
    echo ""
    awk '/# (─+ *)?JSON section:/{p=1} p && /^[^#]/{exit} p{sub(/^# ?/,""); print}' "$0"
    exit 0
fi
if [[ "${1}" == "--input-definition" || "${1}" == "--schema" ]]; then
    lab_schema "$0" "${2:-json}"
    exit $?
fi


# load lab_creation defaults
if [[ -f /etc/lab_creation.defaults ]]
then
        . /etc/lab_creation.defaults
elif [[ -f lab_creation.defaults ]]
then
        . lab_creation.defaults
else
        echo "ERROR: Configuration file lab_creation.defaults not found in local path or /etc"
        exit 1
fi

# Load primary functions
. ${_primary_funtions} || exit 1

# load Kubernetes functions
. ${_lib_path}/k8s_functions.bash


# Setup SUSE Application Collection Helm repo
function setup_appcollection_repo() {
        _repo_name="${appcollection_rel:-suse-application-collection}"
        _repo_url="${appcollection_repo_url:-https://charts.suse.com/application-collection}"
        helm_repo_add
}

# Add the repo and optionally install a single chart from it
function setup_appcollection() {
        if [[ -n "${appcollection_chart}" ]]
        then
                _ver="${appcollection_version:+--version ${appcollection_version}}"
                _release="${appcollection_release:-${appcollection_chart}}"
                $ssh_command "helm upgrade -i ${_release} \
                        ${appcollection_rel:-suse-application-collection}/${appcollection_chart} \
                        --namespace ${appcollection_ns:-app-collection} \
                        --create-namespace \
                        ${_ver}"
                echo "Installed '${appcollection_chart}' from SUSE Application Collection."
        else
                echo "SUSE Application Collection repo added."
                echo "List available charts with:"
                echo "  helm search repo ${appcollection_rel:-suse-application-collection}"
        fi
}


# load cluster and product vars
load_kclu_vars
load_appcollection_vars

on_first_server setup_helm setup_appcollection_repo setup_appcollection
