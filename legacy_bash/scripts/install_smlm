#!/bin/bash
# Part of lab-in-a-box, it will install SUSE Multi-Linux Manager (SMLM) on Kubernetes
# Author/s: Raul Mahiques
# License: GPLv3
#
#  This program is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, either version 3 of the License, or (at your option) any later version.
#
# This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for more details.
#
# You should have received a copy of the GNU General Public License along with this program. If not, see <https://www.gnu.org/licenses/gpl-3.0.html>.
#
# Reference: https://documentation.suse.com/multi-linux-manager/5.2/en/docs/specialized-guides/kubernetes-guide/server-kubernetes-deployment.html
#
# ─── JSON section: "smlm" ───────────────────────────────────────────────────────
#
# MANDATORY
#   smlm_fqdn             : Fully-qualified domain name for the SMLM server
#                           (e.g. "smlm.cluster1.mydemo.lab")
#   smlm_scc_user         : SUSE Customer Center (SCC) username (mirroring credentials)
#   smlm_scc_password     : SUSE Customer Center (SCC) password
#
# OPTIONAL – passwords/credentials
#   smlm_db_admin_user    : DB admin username          (default: mlmadmin)
#   smlm_db_admin_pass    : DB admin password          (default: mlmadmin123)
#   smlm_db_user          : DB application username    (default: mlmuser)
#   smlm_db_pass          : DB application password    (default: mlmuser123)
#   smlm_reportdb_user    : Report DB username         (default: reportuser)
#   smlm_reportdb_pass    : Report DB password         (default: reportuser123)
#   smlm_admin_user       : SMLM web UI admin username (default: admin)
#   smlm_admin_pass       : SMLM web UI admin password (default: admin123)
#
# OPTIONAL – Helm / release
#   smlm_version          : Helm chart version         (empty = latest, e.g. "5.2.0")
#   smlm_ns               : Kubernetes namespace       (default: uyuni-server)
#   smlm_rel              : Helm release name          (default: smlm-server)
#   smlm_registry         : OCI registry for the chart (default: registry.suse.com)
#   smlm_chart            : OCI chart path             (default: suse/multi-linux-manager/5.2/server-helm)
#   smlm_img_repository   : Image repository base      (default: derived from
#                           smlm_registry/smlm_chart + '/x86_64', e.g.
#                           registry.suse.com/suse/multi-linux-manager/5.2/x86_64)
#   smlm_img_tag          : Image tag for all images   (default: chart default, "latest")
#
# OPTIONAL – networking / ingress
#   smlm_shorthn          : Short hostname for DNS entry (default: smlm)
#   smlm_ingress_class    : Ingress class name         (default: traefik)
#                           NOTE: nginx is not supported by the SMLM chart; use traefik.
#
# OPTIONAL – security
#   smlm_super_privileged : Set to "true" to run in super-privileged mode
#                           (default: false — uses AppArmor/SELinux profiles)
#
# OPTIONAL – storage
#   smlm_storage_class    : StorageClass name          (empty = cluster default)
#   smlm_lh_overprovision : Longhorn storage-over-provisioning percentage set
#                           when smlm_storage_class is "longhorn" (default: 500)
#
# EXPERIMENTAL – HA database
#   smlm_db_ha            : "true" replaces the chart's single-pod PostgreSQL
#                           with an HA cluster managed by the CloudNativePG
#                           operator (default: false). The bundled db is
#                           disabled (db.enable=false) and the 'db'/'reportdb'
#                           hostnames become aliases of the operator's
#                           failover-aware primary Service (smlm-db-rw), so a
#                           failed DB pod/host is replaced by a standby with
#                           no corruption. Real host-level HA needs a kcluster
#                           with at least as many nodes as replicas.
#   smlm_db_ha_replicas   : Number of PostgreSQL instances   (default: 3)
#   smlm_db_ha_sync       : "true" (default) = synchronous replication: a
#                           primary failure loses no committed transaction,
#                           but writes stall while no standby is available.
#                           "false" = async (may lose the last commits).
#   smlm_db_ha_size       : Data volume size per instance    (default: 50Gi)
#   smlm_db_ha_pg_image   : PostgreSQL image (default:
#                           ghcr.io/cloudnative-pg/postgresql:18 — the major
#                           version must match SMLM 5.2's PostgreSQL 18)
#   smlm_db_ha_cnpg_version : CloudNativePG operator chart version (default: latest)
#
#   Failover test: after the lab is deployed, run
#       install_smlm <lab.json> --test-failover
#   It writes a canary row through the same path uyuni uses, deletes the
#   current primary pod, measures promotion and write-recovery time, and
#   verifies no committed row was lost and the web UI stayed up. For a harder
#   test power off the VM of the primary's node on the hypervisor instead.
#
# NOTE: RKE2 (default) or K3s, with Traefik. On RKE2, Traefik is enabled
#       through the 'ingress-controller' option and the extra TCP ports 4505,
#       4506 (Salt) and 5432 (report DB) are exposed via a rke2-traefik
#       HelmChartConfig. On K3s (kclusters clu_type "k3s") the bundled Traefik
#       is reused and the same ports are exposed through its ServiceLB.



_VERSION="__LABVERSION__"
[[ "${1}" == "--version" || "${1}" == "-v" ]] && echo "${0##*/} ${_VERSION}" && exit 0
if [[ "${1}" == "--validate" ]]; then
    _vf="${2}" _ve=0
    _vreq() { local _v; _v=$(jq -r ".${1}.${2} // \"\""  < "${_vf}" 2>/dev/null); [[ -n "${_v}" ]] || { echo "[ERROR] ${1}.${2} is required (no default)"; ((_ve++)); }; }
    _vns()  { local _v; _v=$(jq -r ".${1}.${1}_ns // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[a-z0-9][a-z0-9-]{0,62}$' || { echo "[ERROR] ${1}.${1}_ns='${_v}': invalid namespace (lowercase, alphanumeric, hyphens only)"; ((_ve++)); }; }
    _vver() { local _v; _v=$(jq -r ".${1}.${1}_version // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+\.[0-9]' || { echo "[ERROR] ${1}.${1}_version='${_v}': not a valid version (expected X.Y…)"; ((_ve++)); }; }
    _vurl() { local _v; _v=$(jq -r ".${1}.${1}_repo_url // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^https?://' || { echo "[ERROR] ${1}.${1}_repo_url='${_v}': must start with https://"; ((_ve++)); }; }
    _vbool(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" || "${_v}" == "true" || "${_v}" == "false" ]] || { echo "[ERROR] ${1}.${2}='${_v}': must be 'true' or 'false'"; ((_ve++)); }; }
    _vport(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+$' || { echo "[ERROR] ${1}.${2}='${_v}': must be a port number"; ((_ve++)); }; }
    _vreq smlm smlm_fqdn
    _vreq smlm smlm_scc_user
    _vreq smlm smlm_scc_password
    _vns smlm; _vver smlm
    _vbool smlm smlm_super_privileged
    _vbool smlm smlm_db_ha
    _vbool smlm smlm_db_ha_sync
    _vport smlm smlm_db_ha_replicas
    exit ${_ve}
fi

if [[ "${1}" == "--help" ]]; then
    echo "Usage: ${0##*/} <lab.json> [<vm_name>]"
    echo "       ${0##*/} <lab.json> --test-failover   # HA DB failover test (requires smlm_db_ha)"
    echo ""
    awk '/# (─+ *)?JSON section:/{p=1} p && /^[^#]/{exit} p{sub(/^# ?/,""); print}' "$0"
    exit 0
fi
if [[ "${1}" == "--input-definition" || "${1}" == "--schema" ]]; then
    lab_schema "$0" "${2:-json}"
    exit $?
fi

echo "Starting installation script for SMLM"


# load lab_creation defaults
if [[ -f /etc/lab_creation.defaults ]]
then
        . /etc/lab_creation.defaults
elif [[ -f lab_creation.defaults ]]
then
        . lab_creation.defaults
else
        echo "ERROR: Configuration file lab_creation.defaults not found in local path or /etc"
        exit 1
fi

# Load primary functions
. ${_primary_funtions} || exit 1

# load Kubernetes functions
. ${_lib_path}/k8s_functions.bash || exit 1


# ─── Traefik configuration ─────────────────────────────────────────────────────
# Exposes the additional TCP entrypoints the SMLM chart routes to (Salt:
# salt-publish/salt-request, reportDB: reportdb-pgsql) via the shared Traefik
# library functions. The cluster type (kclusters clu_type) picks the method:
# rke2 (default) enables the RKE2 Traefik ingress; k3s reuses the bundled one.

function setup_smlm_traefik() {
        if [[ "${clu_type}" == "k3s" ]]
        then
                setup_traefik_k3s salt-publish:4505 salt-request:4506 reportdb-pgsql:5432
        else
                setup_traefik_rke2 salt-publish:4505 salt-request:4506 reportdb-pgsql:5432
        fi
}


# ─── Namespace and secrets ─────────────────────────────────────────────────────

function setup_smlm_prereqs() {
        _ns="${smlm_ns:-uyuni-server}"

        # SMLM claims ~270Gi of nominal volume space (100Gi srv-www, 100Gi
        # var-spacewalk, 50Gi pgsql, …); on a lab node with a smaller disk the
        # replicas can never be scheduled. Longhorn volumes are thin, so raise
        # the over-provisioning limit to let them schedule.
        if [[ "${smlm_storage_class:-}" == "longhorn" ]]
        then
                set_longhorn_overprovisioning "${smlm_lh_overprovision:-500}"
        fi

        _msg="# Creating namespace and secrets in '${_ns}'" show_nicer_messages

        $ssh_command "kubectl create namespace ${_ns} 2>/dev/null || true"

        # SCC image pull secret
        $ssh_command "kubectl create secret docker-registry scc-credentials \
                -n ${_ns} \
                --docker-server=${smlm_registry:-registry.suse.com} \
                --docker-username='${smlm_scc_user}' \
                --docker-password='${smlm_scc_password}' \
                --dry-run=client -o yaml | kubectl apply -f -"

        # DB credentials secrets (basic-auth format)
        create_basic_auth_secret "${_ns}" "db-admin-credentials" \
                "${smlm_db_admin_user:-mlmadmin}" "${smlm_db_admin_pass:-mlmadmin123}"
        create_basic_auth_secret "${_ns}" "db-credentials" \
                "${smlm_db_user:-mlmuser}" "${smlm_db_pass:-mlmuser123}"
        create_basic_auth_secret "${_ns}" "reportdb-credentials" \
                "${smlm_reportdb_user:-reportuser}" "${smlm_reportdb_pass:-reportuser123}"
        create_basic_auth_secret "${_ns}" "admin-credentials" \
                "${smlm_admin_user:-admin}" "${smlm_admin_pass:-admin123}"

        # Self-signed TLS certificates (for lab use; replace with real certs in production)
        _msg="  Generating self-signed TLS certificates" show_nicer_messages
        $ssh_command "
set -e
_fqdn='${smlm_fqdn}'
_ns='${_ns}'
_tmp=\$(mktemp -d)

# Server cert
openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
    -keyout \${_tmp}/tls.key \
    -out    \${_tmp}/tls.crt \
    -subj \"/CN=\${_fqdn}\" \
    -addext \"subjectAltName=DNS:\${_fqdn}\" 2>/dev/null

kubectl create secret tls uyuni-cert -n \${_ns} \
    --cert=\${_tmp}/tls.crt \
    --key=\${_tmp}/tls.key \
    --dry-run=client -o yaml | kubectl apply -f -

kubectl create configmap uyuni-ca -n \${_ns} \
    --from-file=ca.crt=\${_tmp}/tls.crt \
    --dry-run=client -o yaml | kubectl apply -f -

# Report DB cert (reuse same CA for lab)
kubectl create secret generic db-cert -n \${_ns} \
    --from-file=ca.crt=\${_tmp}/tls.crt \
    --from-file=tls.crt=\${_tmp}/tls.crt \
    --from-file=tls.key=\${_tmp}/tls.key \
    --dry-run=client -o yaml | kubectl apply -f -

kubectl create configmap db-ca -n \${_ns} \
    --from-file=ca.crt=\${_tmp}/tls.crt \
    --dry-run=client -o yaml | kubectl apply -f -

rm -rf \${_tmp}"
}

# ─── EXPERIMENTAL: HA database (CloudNativePG) ─────────────────────────────────
# Replaces the chart's single-pod db with a CloudNativePG cluster of
# smlm_db_ha_replicas PostgreSQL instances spread across the Kubernetes hosts
# (pod anti-affinity on kubernetes.io/hostname). The operator keeps one
# primary plus streaming-replication standbys and maintains the 'smlm-db-rw'
# Service that always points at the current primary — that Service is the
# failover-aware "load balancer": a round-robin LB across instances would
# split writes and corrupt a single-primary PostgreSQL, so writes must always
# land on the primary and failover means re-pointing, which the operator does.
# With synchronous replication (default) a primary failure loses no committed
# transaction. uyuni keeps using the hostnames 'db' and 'reportdb' (hardcoded
# in the chart): they are created as ExternalName aliases of smlm-db-rw.

function setup_smlm_db_ha() {
        _ns="${smlm_ns:-uyuni-server}"
        _replicas="${smlm_db_ha_replicas:-3}"

        setup_cnpg_operator "${smlm_db_ha_cnpg_version}"

        _msg="# [experimental] Creating HA PostgreSQL cluster 'smlm-db' (${_replicas} instances)" show_nicer_messages

        _sc_line=""
        [[ -n "${smlm_storage_class}" ]] && _sc_line="    storageClass: ${smlm_storage_class}"
        _sync_block=""
        if [[ "${smlm_db_ha_sync:-true}" == "true" && "${_replicas}" -gt 1 ]]
        then
                _sync_block="  postgresql:
    synchronous:
      method: any
      number: 1"
        fi

        # Roles, databases and ownership mirror what the bundled db image
        # creates; postInitSQL only runs on the very first bootstrap
        $ssh_command "cat > /tmp/smlm-db-cluster.yaml" <<EOF
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: smlm-db
  namespace: ${_ns}
spec:
  instances: ${_replicas}
  imageName: ${smlm_db_ha_pg_image:-ghcr.io/cloudnative-pg/postgresql:18}
  primaryUpdateStrategy: unsupervised
  affinity:
    enablePodAntiAffinity: true
    topologyKey: kubernetes.io/hostname
    podAntiAffinityType: preferred
${_sync_block}
  storage:
    size: ${smlm_db_ha_size:-50Gi}
${_sc_line}
  bootstrap:
    initdb:
      postInitSQL:
        - CREATE ROLE "${smlm_db_admin_user:-mlmadmin}" SUPERUSER LOGIN PASSWORD '${smlm_db_admin_pass:-mlmadmin123}'
        - CREATE ROLE "${smlm_db_user:-mlmuser}" LOGIN PASSWORD '${smlm_db_pass:-mlmuser123}'
        - CREATE ROLE "${smlm_reportdb_user:-reportuser}" LOGIN PASSWORD '${smlm_reportdb_pass:-reportuser123}'
        - CREATE DATABASE susemanager OWNER "${smlm_db_user:-mlmuser}"
        - CREATE DATABASE reportdb OWNER "${smlm_reportdb_user:-reportuser}"
EOF

        # Right after the operator install its admission webhook may not be
        # reachable yet — retry the apply
        for _i in {1..10}
        do
                $ssh_command "kubectl apply -f /tmp/smlm-db-cluster.yaml" && break
                _msg="  CNPG webhook not ready yet, retrying (${_i}/10) …" show_nicer_messages
                sleep 15
        done
        $ssh_command "kubectl get cluster smlm-db -n ${_ns}" &>/dev/null \
                || _msg="could not create the smlm-db CNPG cluster" fail_with_error
        $ssh_command "rm -f /tmp/smlm-db-cluster.yaml"

        _msg="  Waiting for ${_replicas} database instances to be ready …" show_nicer_messages
        for _i in {1..60}
        do
                _ready=$($ssh_command "kubectl get cluster smlm-db -n ${_ns} -o jsonpath='{.status.readyInstances}' 2>/dev/null")
                [[ "${_ready}" == "${_replicas}" ]] && break
                sleep 15
        done
        [[ "${_ready}" == "${_replicas}" ]] \
                || _msg="HA database not ready (${_ready:-0}/${_replicas}) — check: kubectl get cluster smlm-db -n ${_ns}" fail_with_error

        # The SMLM schema needs pg_trgm in the main database
        $ssh_command "kubectl exec -n ${_ns} \$(kubectl get pods -n ${_ns} \
                -l cnpg.io/cluster=smlm-db,cnpg.io/instanceRole=primary -o name | head -1) \
                -c postgres -- psql -d susemanager -tAc 'CREATE EXTENSION IF NOT EXISTS pg_trgm'" \
                || _msg="could not create the pg_trgm extension in susemanager" fail_with_error

        # The chart hardcodes MANAGER_DB_HOST=db and REPORT_DB_HOST=reportdb
        # in the uyuni deployment (db.internal.host is not honoured there) —
        # alias both names to the failover-aware primary Service
        $ssh_command "kubectl apply -f -" <<EOF || _msg="could not create the db/reportdb Service aliases" fail_with_error
apiVersion: v1
kind: Service
metadata:
  name: db
  namespace: ${_ns}
spec:
  type: ExternalName
  externalName: smlm-db-rw.${_ns}.svc.cluster.local
---
apiVersion: v1
kind: Service
metadata:
  name: reportdb
  namespace: ${_ns}
spec:
  type: ExternalName
  externalName: smlm-db-rw.${_ns}.svc.cluster.local
EOF
}


# ─── EXPERIMENTAL: HA database failover test (--test-failover) ─────────────────
# Verifies the promise of the HA mode: kill the primary, a standby is
# promoted, the smlm-db-rw Service re-points, no committed row is lost and
# the application keeps working. SQL goes through the exact path uyuni uses
# (host 'db' → ExternalName → smlm-db-rw → primary), executed from inside
# the uyuni container with its own credentials. The canary SQL must not
# contain single quotes (nested ssh/exec quoting), hence numeric values only.

function _smlm_canary_sql() {
        $ssh_command "kubectl exec -n ${_ns} deploy/uyuni -c uyuni -- sh -c \
                'PGPASSWORD=\$MANAGER_PASS psql -h \$MANAGER_DB_HOST -p \$MANAGER_DB_PORT \
                -U \$MANAGER_USER -d \$MANAGER_DB_NAME -tAc \"${1}\"'"
}

function _smlm_db_primary() {
        $ssh_command "kubectl get pods -n ${_ns} \
                -l cnpg.io/cluster=smlm-db,cnpg.io/instanceRole=primary \
                -o jsonpath='{.items[0].metadata.name} {.items[0].spec.nodeName}' 2>/dev/null"
}

function smlm_db_failover_test() {
        _ns="${smlm_ns:-uyuni-server}"
        _fail_reasons=""

        $ssh_command "kubectl get cluster smlm-db -n ${_ns}" &>/dev/null \
                || _msg="no smlm-db cluster in '${_ns}' — deploy the lab with smlm_db_ha \"true\" first" fail_with_error
        _replicas=$($ssh_command "kubectl get cluster smlm-db -n ${_ns} -o jsonpath='{.spec.instances}'")

        _msg="# [experimental] HA database failover test (${_replicas} instances)" show_nicer_messages

        read -r _old_primary _old_node <<< "$(_smlm_db_primary)"
        [[ -z "${_old_primary}" ]] && _msg="could not determine the current primary pod" fail_with_error
        _msg="  Current primary: ${_old_primary} (node ${_old_node})" show_nicer_messages

        _msg="  Writing canary row through the uyuni DB path …" show_nicer_messages
        _smlm_canary_sql "DROP TABLE IF EXISTS lab_failover_canary" >/dev/null
        _smlm_canary_sql "CREATE TABLE lab_failover_canary(i int, ts timestamptz DEFAULT now())" >/dev/null \
                || _msg="canary write failed before the failover — DB path is not working" fail_with_error
        _smlm_canary_sql "INSERT INTO lab_failover_canary(i) VALUES (1)" >/dev/null \
                || _msg="canary write failed before the failover — DB path is not working" fail_with_error

        _web_before=$(curl -kso /dev/null -w '%{http_code}' --max-time 15 "https://${smlm_fqdn}/rhn/manager/login")
        _msg="  Web UI before failover: HTTP ${_web_before}" show_nicer_messages

        _msg="  Deleting the primary pod (simulated failure) …" show_nicer_messages
        $ssh_command "kubectl delete pod ${_old_primary} -n ${_ns} --wait=false" \
                || _msg="could not delete the primary pod" fail_with_error
        SECONDS=0

        _new_primary=""
        for _i in {1..60}
        do
                read -r _new_primary _new_node <<< "$(_smlm_db_primary)"
                [[ -n "${_new_primary}" && "${_new_primary}" != "${_old_primary}" ]] && break
                sleep 2
        done
        if [[ -n "${_new_primary}" && "${_new_primary}" != "${_old_primary}" ]]
        then
                _promote_s=${SECONDS}
                _msg="  Promoted:  ${_new_primary} (node ${_new_node}) after ${_promote_s}s" show_nicer_messages
        else
                _fail_reasons="${_fail_reasons}; no standby was promoted within 120s"
                _promote_s="-"
        fi

        # First successful write after the kill = end-to-end recovery time
        _write_s="-"
        for _i in {1..60}
        do
                if _smlm_canary_sql "INSERT INTO lab_failover_canary(i) VALUES (2)" &>/dev/null
                then
                        _write_s=${SECONDS}
                        break
                fi
                sleep 2
        done
        [[ "${_write_s}" == "-" ]] && _fail_reasons="${_fail_reasons}; writes did not recover within 120s"

        _rows=$(_smlm_canary_sql "SELECT count(*) FROM lab_failover_canary" | tr -dc '0-9')
        [[ "${_rows}" == "2" ]] || _fail_reasons="${_fail_reasons}; expected 2 canary rows, found '${_rows}' (committed data lost?)"

        _web_after=$(curl -kso /dev/null -w '%{http_code}' --max-time 15 "https://${smlm_fqdn}/rhn/manager/login")
        [[ "${_web_after}" == "200" ]] || _fail_reasons="${_fail_reasons}; web UI returned HTTP ${_web_after} after the failover"

        _msg="  Waiting for the cluster to heal (${_replicas}/${_replicas} instances) …" show_nicer_messages
        _healed="no"
        for _i in {1..60}
        do
                _ready=$($ssh_command "kubectl get cluster smlm-db -n ${_ns} -o jsonpath='{.status.readyInstances}' 2>/dev/null")
                [[ "${_ready}" == "${_replicas}" ]] && _healed="yes" && break
                sleep 10
        done
        [[ "${_healed}" == "yes" ]] || _fail_reasons="${_fail_reasons}; cluster did not return to ${_replicas} ready instances within 10 min"

        _smlm_canary_sql "DROP TABLE IF EXISTS lab_failover_canary" >/dev/null

        echo ""
        echo "─── HA database failover test ─────────────────────────────"
        echo "  Old primary     : ${_old_primary} (node ${_old_node})"
        echo "  New primary     : ${_new_primary:-none} (node ${_new_node:-—})"
        echo "  Promotion time  : ${_promote_s}s"
        echo "  Write recovery  : ${_write_s}s"
        echo "  Canary rows     : ${_rows}/2 (row 1 committed before, row 2 after)"
        echo "  Web UI          : HTTP ${_web_before} before / HTTP ${_web_after} after"
        echo "  Cluster healed  : ${_healed}"
        echo "────────────────────────────────────────────────────────────"
        if [[ -n "${_fail_reasons}" ]]
        then
                _msg="HA failover test FAILED: ${_fail_reasons#; }" fail_with_error
        fi
        echo "  RESULT: PASSED — primary lost, service continued, no data lost."
        echo ""
}


# ─── Helm install ──────────────────────────────────────────────────────────────

function setup_smlm() {
        _ns="${smlm_ns:-uyuni-server}"
        _rel="${smlm_rel:-smlm-server}"
        _chart="oci://${smlm_registry:-registry.suse.com}/${smlm_chart:-suse/multi-linux-manager/5.2/server-helm}"
        _ver="${smlm_version:+--version ${smlm_version}}"

        _storage_class="${smlm_storage_class:+--set global.storageClassName=${smlm_storage_class}}"
        _security=""
        [[ "${smlm_super_privileged:-false}" == "true" ]] && \
                _security="--set server.superPrivileged=true"

        # The chart's default image repository lacks the arch subpath — the
        # actual images live under …/multi-linux-manager/5.2/x86_64/
        if [[ -n "${smlm_img_repository}" ]]
        then
                _img_repo="${smlm_img_repository}"
        else
                _img_repo="${smlm_registry:-registry.suse.com}/${smlm_chart:-suse/multi-linux-manager/5.2/server-helm}"
                _img_repo="${_img_repo%/server-helm}/x86_64"
        fi
        _img_tag="${smlm_img_tag:+--set tag=${smlm_img_tag}}"

        # EXPERIMENTAL HA database: the bundled single-pod db is disabled;
        # the CNPG cluster created by setup_smlm_db_ha takes its place
        _db_ha=""
        [[ "${smlm_db_ha:-false}" == "true" ]] && _db_ha="--set db.enable=false"

        _msg="# Installing SUSE Multi-Linux Manager (${_rel})" show_nicer_messages

        $ssh_command "helm upgrade -i ${_rel} ${_chart} \
                --namespace ${_ns} \
                --create-namespace \
                --set global.fqdn='${smlm_fqdn}' \
                --set registrySecret=scc-credentials \
                --set repository=${_img_repo} \
                --set ingress.className=${smlm_ingress_class:-traefik} \
                ${_storage_class} \
                ${_security} \
                ${_img_tag} \
                ${_db_ha} \
                ${_ver}" || _msg="helm install failed for SMLM" fail_with_error

        if [[ "${smlm_db_ha:-false}" != "true" ]]
        then
                # Longhorn/block PVCs are ext4 mounts containing lost+found, which
                # initdb refuses to use as PGDATA — point it to a subdirectory of the
                # mount instead (the image entrypoint honours \$PGDATA)
                $ssh_command "kubectl set env deploy/db -n ${_ns} PGDATA=/var/lib/pgsql/data/pgdata" \
                        || _msg="could not set PGDATA on the db deployment" fail_with_error

                # kubelet re-applies fsGroup group-write permissions to the volume on
                # every attach, which postgres rejects (data dir must be 0700/0750) —
                # restore the mode in an init container before the db starts
                $ssh_command "kubectl patch deploy db -n ${_ns} -p '{\"spec\":{\"template\":{\"spec\":{\"initContainers\":[{
                        \"name\":\"pgdata-perms\",
                        \"image\":\"${_img_repo}/server-postgresql:${smlm_img_tag:-latest}\",
                        \"command\":[\"sh\",\"-c\",\"[ -d /var/lib/pgsql/data/pgdata ] && chmod 0700 /var/lib/pgsql/data/pgdata; true\"],
                        \"securityContext\":{\"runAsUser\":0},
                        \"volumeMounts\":[{\"mountPath\":\"/var/lib/pgsql/data\",\"name\":\"var-pgsql\"}]}]}}}}'" \
                        || _msg="could not add pgdata-perms init container to the db deployment" fail_with_error
        fi

        # The chart's init-volumes container seeds each PVC from the image only
        # when the volume is empty — ext4 PVCs always contain lost+found, so
        # nothing ever gets seeded. Replace its command with one that drops
        # empty lost+found dirs first (volume list derived from /proc/mounts).
        $ssh_command "cat > /tmp/uyuni-initvol-patch.json" <<'PATCH_EOF'
{"spec":{"template":{"spec":{"initContainers":[{
  "name": "init-volumes",
  "command": ["sh", "-x", "-c",
    "for mnt in $(awk '$2 ~ /^\\/mnt\\// {print $2}' /proc/mounts); do vol=${mnt#/mnt}; rmdir $mnt/lost+found 2>/dev/null; [ -d $vol ] || continue; chown --reference=$vol $mnt; chmod --reference=$vol $mnt; if [ -z \"$(ls -A $mnt)\" ]; then cp -a $vol/. $mnt || exit 1; fi; done; exit 0"]
}]}}}}
PATCH_EOF
        $ssh_command "kubectl patch deploy uyuni -n ${_ns} --patch-file /tmp/uyuni-initvol-patch.json && rm -f /tmp/uyuni-initvol-patch.json" \
                || _msg="could not patch init-volumes on the uyuni deployment" fail_with_error

        _msg="# Adding DNS entry for SMLM" show_nicer_messages
        _dns_entry="${smlm_shorthn:-smlm}.${clu_name}"
        add_service_dns

        _msg="# Waiting for SMLM pods to be ready (this can take 15+ minutes on first boot) …" show_nicer_messages
        $ssh_command "kubectl wait pods -n ${_ns} --all \
                --for condition=Ready --timeout=1500s 2>/dev/null" || \
        _msg="Pods not fully ready after 25 min — check: kubectl get pods -n ${_ns}" show_nicer_messages

        echo ""
        echo "SUSE Multi-Linux Manager deployed."
        echo "  URL     : https://${smlm_fqdn}"
        echo "  User    : ${smlm_admin_user:-admin}"
        echo "  Password: ${smlm_admin_pass:-admin123}"
        echo ""
        echo "  Salt clients point to: ${smlm_fqdn}:4505 / 4506"
}


# ─── Main ──────────────────────────────────────────────────────────────────────

# load cluster and smlm variables
load_kclu_vars
load_smlm_vars

# Validate mandatory variables
[[ -z "${smlm_fqdn}" ]]         && { echo "ERROR: smlm_fqdn is required in the 'smlm' JSON section" >&2; exit 1; }
[[ -z "${smlm_scc_user}" ]]     && { echo "ERROR: smlm_scc_user is required in the 'smlm' JSON section" >&2; exit 1; }
[[ -z "${smlm_scc_password}" ]] && { echo "ERROR: smlm_scc_password is required in the 'smlm' JSON section" >&2; exit 1; }

# Run the HA failover test instead of installing when requested
if [[ "${2}" == "--test-failover" ]]
then
        on_first_server smlm_db_failover_test
        exit $?
fi

_setup_fns="setup_helm setup_smlm_traefik setup_smlm_prereqs"
[[ "${smlm_db_ha:-false}" == "true" ]] && _setup_fns="${_setup_fns} setup_smlm_db_ha"

on_first_server \
        ${_setup_fns} \
        setup_smlm
