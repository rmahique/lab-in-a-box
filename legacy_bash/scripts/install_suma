_VERSION="__LABVERSION__"
# JSON section: "suma" — SUSE Manager (SUMA) host-level deployment
#   NOTE: Installed directly on the OS via mgradm, not in Kubernetes.
#         The target node must list "suma" in its nodes[x].addons[] array.
#
#   suma_reg_username : [OPTIONAL] registry.suse.com login username    (default: admin@mydemo.lab)
#   suma_reg_pwd      : [OPTIONAL] registry.suse.com login password    (default: aaaaaaaa)
#   suma_adm_pwd      : [OPTIONAL] SUMA web UI admin password          (default: admin123)

[[ "${1}" == "--version" || "${1}" == "-v" ]] && echo "${0##*/} ${_VERSION}" && exit 0
if [[ "${1}" == "--validate" ]]; then
    _vf="${2}" _ve=0
    _vreq() { local _v; _v=$(jq -r ".${1}.${2} // \"\""  < "${_vf}" 2>/dev/null); [[ -n "${_v}" ]] || { echo "[ERROR] ${1}.${2} is required (no default)"; ((_ve++)); }; }
    _vns()  { local _v; _v=$(jq -r ".${1}.${1}_ns // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[a-z0-9][a-z0-9-]{0,62}$' || { echo "[ERROR] ${1}.${1}_ns='${_v}': invalid namespace (lowercase, alphanumeric, hyphens only)"; ((_ve++)); }; }
    _vver() { local _v; _v=$(jq -r ".${1}.${1}_version // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+\.[0-9]' || { echo "[ERROR] ${1}.${1}_version='${_v}': not a valid version (expected X.Y…)"; ((_ve++)); }; }
    _vurl() { local _v; _v=$(jq -r ".${1}.${1}_repo_url // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^https?://' || { echo "[ERROR] ${1}.${1}_repo_url='${_v}': must start with https://"; ((_ve++)); }; }
    _vbool(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" || "${_v}" == "true" || "${_v}" == "false" ]] || { echo "[ERROR] ${1}.${2}='${_v}': must be 'true' or 'false'"; ((_ve++)); }; }
    _vport(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+$' || { echo "[ERROR] ${1}.${2}='${_v}': must be a port number"; ((_ve++)); }; }
    exit ${_ve}
fi

if [[ "${1}" == "--help" ]]; then
    echo "Usage: ${0##*/} <lab.json> [<vm_name>]"
    echo ""
    awk '/# (─+ *)?JSON section:/{p=1} p && /^[^#]/{exit} p{sub(/^# ?/,""); print}' "$0"
    exit 0
fi
if [[ "${1}" == "--input-definition" || "${1}" == "--schema" ]]; then
    lab_schema "$0" "${2:-json}"
    exit $?
fi


# load lab_creation defaults
if [[ -f /etc/lab_creation.defaults ]]
then
        . /etc/lab_creation.defaults
elif [[ -f lab_creation.defaults ]]
then
        . lab_creation.defaults
else
        echo "ERROR: Configuration file lab_creation.defaults not found in local path or /etc"
        exit 1
fi

# Load primary functions
. ${_primary_funtions} || exit 1



# Load SUMA related variables.
function load_suma_vars() {
       _section="suma"
       _load_vars
}



# Setup suma
function setup_suma() {
                _msg="- Registering system to SUMA channel" show_nicer_messages
                $ssh_command "transactional-update --quiet register -p ${suma_channel:-SUSE-Manager-Server/5.0/x86_64} -r ${suma_key:-aaaaaa} ; reboot"
                sleep 5
                check_ssh_conn
                _msg="- install utility packages" show_nicer_messages

                $ssh_command "transactional-update --quiet pkg install -y mgradm-bash-completion mgrctl-bash-completion mgradm-zsh-completion mgrctl-zsh-completion; reboot"
                sleep 5
                check_ssh_conn
                if [[ "${extra_dsk}" != "" ]]
                then
                  for _dsk in ${extra_dsk}
                  do
                    _msg="- Adding extra disk ${_dsk}" show_nicer_messages
                    #if [[ "${_dsk}" =~ "UUID" ]]
                    #then
                      $ssh_command "echo \"mirror /srv/mirror 9p trans=virtio,version=9p2000.L,nofail,_netdev,x-mount.mkdir 0 0\" >> /etc/fstab ;  mkdir /srv/mirror"
                    #  _dsk="${_dsk//,*}"
                    #  _dsk=`$ssh_command "lsblk -o UUID,PATH | grep ${_dsk//UUID=} | cut -d' ' -f2"`
                    #  $ssh_command "mgr-storage-server ${_dsk}"
                    #fi
                    $ssh_command "echo \"${_dsk//,*} ${_dsk//*,} xfs defaults,nofail 1 2\" >>/etc/fstab"
                  done
                  reboot_vm
                  sleep 5
                  check_ssh_conn

                else
                   echo "NO EXTRA_DSK "
                fi
                _msg="- Installing SUMA" show_nicer_messages

                $ssh_command "podman login --username  ${suma_reg_username:-admin@mydemo.lab} --password ${suma_reg_pwd:-aaaaaaaa} registry.suse.com"
                
                template_file=${_templ_addons_loc}/suma/mgradm.yaml.tmpl
                process_templates | $ssh_command "cat > /var/tmp/mgradm.yaml"
                
#                $ssh_command "mgradm install --admin-password ${suma_adm_pwd:-admin123} --ssl-password ${suma_ssl_pwd:-admin123}  --admin-email ${suma_adm_email:-admin@mydemo.lab} --scc-user ${suma_scc_user:-XYZ} --scc-password ${suma_scc_pwd:-admin123} --mirrorPath ${suma_mirrorPath:-/srv/mirror} --organization ${suma_def_org:-mydemo}  podman"

                $ssh_command "mgradm -c /var/tmp/mgradm.yaml install podman "

                sleep 120

                $ssh_command "reboot"

                sleep 5
                check_ssh_conn

                _msg="- Sync admin user password" show_nicer_messages

                $ssh_command "mgrctl exec -- \"echo -e 'mgrsync.user = admin\nmgrsync.password = ${suma_adm_pwd:-admin123}' >~/.mgr-sync\""

                _msg="SUMA should be available in a few minutes, visit https://${_vm_name}/" show_nicer_messages
                if [[ "${suma_channels}" != "" ]]
                then
                  _count=0
                  _msg="`date` - Let's wait for the channel list to sync'"  show_nicer_messages
                  while true
                  do
                    sleep 5
                    ((_count+=1))
                    printf "Retry $_count\r"
                    $ssh_command  "mgrctl exec -- mgr-sync list channels 2>/dev/null " | grep -iv 'No channels found.'
                    if test $? -eq 0
                    then
                      break
                    fi
                  done
                  _msg="`date` - We will start the process of synching the selected channels, this may take hours" show_nicer_messages
                  echo "list: $suma_channels "
                  # wait 5 minutes to let SUMA start
                  sleep 300
                  $ssh_command "mgrctl exec -- mgr-sync add channels ${suma_channels}"
                fi
}



# load insecure_app variables
load_suma_vars


if [[ "${_vm_name}" == "" ]]
then
  for _vm_name in $(jq -r '.nodes | to_entries[].key' < ${inputFile} |xargs )
  do
    for _addon in $(jq -r ".nodes.\"${_vm_name}\".addons[]" < ${inputFile} 2>/dev/null )
    do
      if [[ "${_addon}" == "suma" ]]
      then
        load_vm_vars
        ssh_command="ssh  -o StrictHostKeyChecking=accept-new  root@${_vm_name}"
        _msg="- Using node: $_vm_name" show_nicer_messages
        setup_suma
      fi
    done
  done
else
  load_vm_vars
  ssh_command="ssh  -o StrictHostKeyChecking=accept-new root@${_vm_name}"
  _msg="- Using node: $_vm_name" show_nicer_messages
  setup_suma
fi


