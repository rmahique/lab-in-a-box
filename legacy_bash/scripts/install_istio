#
# JSON section: "istio" — configurable keys:
#   istio_version       : [OPTIONAL] Helm chart version (empty = latest, e.g. "1.22.3")
#   istio_ns            : [OPTIONAL] control plane namespace (default: istio-system)
#   istio_gateway_ns    : [OPTIONAL] ingress gateway namespace (default: istio-ingress)
#   istio_rel           : [OPTIONAL] Helm repo alias (default: istio)
#   istio_repo_url      : [OPTIONAL] Helm repo URL (default: https://istio-release.storage.googleapis.com/charts)
#   istio_install_gateway: [OPTIONAL] install ingress gateway (default: true)


_VERSION="__LABVERSION__"
[[ "${1}" == "--version" || "${1}" == "-v" ]] && echo "${0##*/} ${_VERSION}" && exit 0
if [[ "${1}" == "--validate" ]]; then
    _vf="${2}" _ve=0
    _vreq() { local _v; _v=$(jq -r ".${1}.${2} // \"\""  < "${_vf}" 2>/dev/null); [[ -n "${_v}" ]] || { echo "[ERROR] ${1}.${2} is required (no default)"; ((_ve++)); }; }
    _vns()  { local _v; _v=$(jq -r ".${1}.${1}_ns // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[a-z0-9][a-z0-9-]{0,62}$' || { echo "[ERROR] ${1}.${1}_ns='${_v}': invalid namespace (lowercase, alphanumeric, hyphens only)"; ((_ve++)); }; }
    _vver() { local _v; _v=$(jq -r ".${1}.${1}_version // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+\.[0-9]' || { echo "[ERROR] ${1}.${1}_version='${_v}': not a valid version (expected X.Y…)"; ((_ve++)); }; }
    _vurl() { local _v; _v=$(jq -r ".${1}.${1}_repo_url // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^https?://' || { echo "[ERROR] ${1}.${1}_repo_url='${_v}': must start with https://"; ((_ve++)); }; }
    _vbool(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" || "${_v}" == "true" || "${_v}" == "false" ]] || { echo "[ERROR] ${1}.${2}='${_v}': must be 'true' or 'false'"; ((_ve++)); }; }
    _vport(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+$' || { echo "[ERROR] ${1}.${2}='${_v}': must be a port number"; ((_ve++)); }; }
    _vns istio; _vver istio
    exit ${_ve}
fi

if [[ "${1}" == "--help" ]]; then
    echo "Usage: ${0##*/} <lab.json> [<vm_name>]"
    echo ""
    awk '/# (─+ *)?JSON section:/{p=1} p && /^[^#]/{exit} p{sub(/^# ?/,""); print}' "$0"
    exit 0
fi
if [[ "${1}" == "--input-definition" || "${1}" == "--schema" ]]; then
    lab_schema "$0" "${2:-json}"
    exit $?
fi


# load lab_creation defaults
if [[ -f /etc/lab_creation.defaults ]]
then
        . /etc/lab_creation.defaults
elif [[ -f lab_creation.defaults ]]
then
        . lab_creation.defaults
else
        echo "ERROR: Configuration file lab_creation.defaults not found in local path or /etc"
        exit 1
fi

# Load primary functions
. ${_primary_funtions} || exit 1

# load Kubernetes functions
. ${_lib_path}/k8s_functions.bash


# Setup Istio Helm repo
function setup_istio_repo() {
        _repo_name="${istio_rel:-istio}"
        _repo_url="${istio_repo_url:-https://istio-release.storage.googleapis.com/charts}"
        helm_repo_add
}

# Install Istio (base → istiod → gateway)
function setup_istio() {
        _ver="${istio_version:+--version ${istio_version}}"

        echo "# Installing Istio base (CRDs)"
        $ssh_command "helm upgrade -i istio-base ${istio_rel:-istio}/base \
                --namespace ${istio_ns:-istio-system} \
                --create-namespace \
                ${_ver}"

        echo "# Installing istiod control plane"
        $ssh_command "helm upgrade -i istiod ${istio_rel:-istio}/istiod \
                --namespace ${istio_ns:-istio-system} \
                --wait \
                ${_ver}"

        if [[ "${istio_install_gateway:-true}" != "false" ]]
        then
                echo "# Installing Istio ingress gateway"
                $ssh_command "kubectl create namespace ${istio_gateway_ns:-istio-ingress} 2>/dev/null || true"
                $ssh_command "helm upgrade -i istio-ingress ${istio_rel:-istio}/gateway \
                        --namespace ${istio_gateway_ns:-istio-ingress} \
                        ${_ver}"
                echo "Istio ingress gateway installed. Namespace: ${istio_gateway_ns:-istio-ingress}"
        fi

        echo "Istio installed. Control plane namespace: ${istio_ns:-istio-system}"
}


# load cluster and product vars
load_kclu_vars
load_istio_vars

on_first_server setup_helm setup_istio_repo setup_istio
