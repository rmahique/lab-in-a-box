_VERSION="__LABVERSION__"
# JSON section: "longhorn" — SUSE Longhorn distributed block storage
#
#   lh_shorthn   : [OPTIONAL] Short hostname for the UI ingress        (default: longhorn)
#   lh_rel       : [OPTIONAL] Helm repo alias                          (default: longhorn)
#   lh_repo_url  : [OPTIONAL] Helm repo URL                           (default: https://charts.longhorn.io)
#   lh_version   : [OPTIONAL] Helm chart version                       (empty = latest)

[[ "${1}" == "--version" || "${1}" == "-v" ]] && echo "${0##*/} ${_VERSION}" && exit 0
if [[ "${1}" == "--validate" ]]; then
    _vf="${2}" _ve=0
    _vreq() { local _v; _v=$(jq -r ".${1}.${2} // \"\""  < "${_vf}" 2>/dev/null); [[ -n "${_v}" ]] || { echo "[ERROR] ${1}.${2} is required (no default)"; ((_ve++)); }; }
    _vns()  { local _v; _v=$(jq -r ".${1}.${1}_ns // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[a-z0-9][a-z0-9-]{0,62}$' || { echo "[ERROR] ${1}.${1}_ns='${_v}': invalid namespace (lowercase, alphanumeric, hyphens only)"; ((_ve++)); }; }
    _vver() { local _v; _v=$(jq -r ".${1}.${1}_version // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+\.[0-9]' || { echo "[ERROR] ${1}.${1}_version='${_v}': not a valid version (expected X.Y…)"; ((_ve++)); }; }
    _vurl() { local _v; _v=$(jq -r ".${1}.${1}_repo_url // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^https?://' || { echo "[ERROR] ${1}.${1}_repo_url='${_v}': must start with https://"; ((_ve++)); }; }
    _vbool(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" || "${_v}" == "true" || "${_v}" == "false" ]] || { echo "[ERROR] ${1}.${2}='${_v}': must be 'true' or 'false'"; ((_ve++)); }; }
    _vport(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+$' || { echo "[ERROR] ${1}.${2}='${_v}': must be a port number"; ((_ve++)); }; }
    _vns longhorn; _vver longhorn; _vurl longhorn
    exit ${_ve}
fi

if [[ "${1}" == "--help" ]]; then
    echo "Usage: ${0##*/} <lab.json> [<vm_name>]"
    echo ""
    awk '/# (─+ *)?JSON section:/{p=1} p && /^[^#]/{exit} p{sub(/^# ?/,""); print}' "$0"
    exit 0
fi
if [[ "${1}" == "--input-definition" || "${1}" == "--schema" ]]; then
    lab_schema "$0" "${2:-json}"
    exit $?
fi


# load lab_creation defaults
if [[ -f /etc/lab_creation.defaults ]]
then
        . /etc/lab_creation.defaults
elif [[ -f lab_creation.defaults ]]
then
        . lab_creation.defaults
else
        echo "ERROR: Configuration file lab_creation.defaults not found in local path or /etc"
        exit 1
fi

# Load primary functions
. ${_primary_funtions} || exit 1

# load Kubernetes functions
. ${_lib_path}/k8s_functions.bash

# Setup SUSE Longhorn helm repository
function setup_lh_repo() {
        _repo_name="${lh_rel:-longhorn}"
        _repo_url="${lh_repo_url:-https://charts.longhorn.io}"
        helm_repo_add
}


 # Setup SUSE Longhorn
function setup_lh() {
                $ssh_command "zypper install -y open-iscsi cryptsetup; systemctl enable --now iscsid.service ; modprobe iscsi_tcp"
                $ssh_command "kubectl create namespace longhorn-system"
                # NOTE: was hardcoded to the "longhorn/longhorn" repo alias regardless of
                # lh_rel, inconsistent with setup_lh_repo (which adds the repo under
                # ${lh_rel:-longhorn}) — if lh_rel is ever customized, this would look for
                # a repo alias that was never added. Fixed to use lh_rel consistently.
                $ssh_command "helm upgrade -i longhorn ${lh_rel:-longhorn}/longhorn --namespace longhorn-system --set ingress.enabled=true --set ingress.host=${lh_shorthn:-longhorn}.${clu_name}.${mydomain}  --set persistence.migratable=true --set longhornUI.replicas=1"
                echo "Longhorn should be available in a few minutes in: ${lh_shorthn:-longhorn}.${clu_name}.${mydomain}"
}
 

# load cluster vars
load_kclu_vars

# load rancher variables
load_rancher_vars

# load longhorn variables
load_lh_vars




# find a server node or API url
for _vm_name in $(jq -r '.nodes | to_entries[].key' < ${inputFile} |xargs)
do
	load_vm_vars
	ssh_command="ssh  -o StrictHostKeyChecking=accept-new -q  root@${_vm_name}"
	if [[ "${INSTALL_RKE2_TYPE}" == "server" || "${INSTALL_RKE2_TYPE}" == "" ]]
	then
		echo "# Using node: $_vm_name"
		setup_helm
		setup_lh_repo
		setup_lh
		sleep 60
		exit 0
	fi
done


