_VERSION="__LABVERSION__"
# JSON section: "struts_demo" — Apache Struts2 vulnerable demo application (CVE-2017-5638)
#
#   struts_demo_ns   : [OPTIONAL] Kubernetes namespace                  (default: struts)
#   struts_demo_name : [OPTIONAL] Deployment, service and ingress name  (default: struts)

[[ "${1}" == "--version" || "${1}" == "-v" ]] && echo "${0##*/} ${_VERSION}" && exit 0
if [[ "${1}" == "--validate" ]]; then
    _vf="${2}" _ve=0
    _vreq() { local _v; _v=$(jq -r ".${1}.${2} // \"\""  < "${_vf}" 2>/dev/null); [[ -n "${_v}" ]] || { echo "[ERROR] ${1}.${2} is required (no default)"; ((_ve++)); }; }
    _vns()  { local _v; _v=$(jq -r ".${1}.${1}_ns // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[a-z0-9][a-z0-9-]{0,62}$' || { echo "[ERROR] ${1}.${1}_ns='${_v}': invalid namespace (lowercase, alphanumeric, hyphens only)"; ((_ve++)); }; }
    _vver() { local _v; _v=$(jq -r ".${1}.${1}_version // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+\.[0-9]' || { echo "[ERROR] ${1}.${1}_version='${_v}': not a valid version (expected X.Y…)"; ((_ve++)); }; }
    _vurl() { local _v; _v=$(jq -r ".${1}.${1}_repo_url // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^https?://' || { echo "[ERROR] ${1}.${1}_repo_url='${_v}': must start with https://"; ((_ve++)); }; }
    _vbool(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" || "${_v}" == "true" || "${_v}" == "false" ]] || { echo "[ERROR] ${1}.${2}='${_v}': must be 'true' or 'false'"; ((_ve++)); }; }
    _vport(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+$' || { echo "[ERROR] ${1}.${2}='${_v}': must be a port number"; ((_ve++)); }; }
    exit ${_ve}
fi

if [[ "${1}" == "--help" ]]; then
    echo "Usage: ${0##*/} <lab.json> [<vm_name>]"
    echo ""
    awk '/# (─+ *)?JSON section:/{p=1} p && /^[^#]/{exit} p{sub(/^# ?/,""); print}' "$0"
    exit 0
fi
if [[ "${1}" == "--input-definition" || "${1}" == "--schema" ]]; then
    lab_schema "$0" "${2:-json}"
    exit $?
fi


# load lab_creation defaults
if [[ -f /etc/lab_creation.defaults ]]
then
        . /etc/lab_creation.defaults
elif [[ -f lab_creation.defaults ]]
then
        . lab_creation.defaults
else
        echo "ERROR: Configuration file lab_creation.defaults not found in local path or /etc"
        exit 1
fi

# Load primary functions
. ${_primary_funtions} || exit 1

# load Kubernetes functions
. ${_lib_path}/k8s_functions.bash

# Load struts demo related variables.
function load_struts_demo_vars() {
       _section="struts_demo"
       _load_vars
}



# Setup NV testing
function setup_struts_demo() {

                $ssh_command "kubectl delete -n ${struts_demo_ns:-struts} service/${struts_demo_name:-struts} deployment.apps/${struts_demo_name:-struts} deployment.apps/attacker ingress/${struts_demo_name:-struts}"
                for _template_to_run in namespace.yml.tmpl install.yml.tmpl service.yml.tmpl ingress.yml.tmpl
 		do
			template_file=${_templ_addons_loc}/struts_demo/${_template_to_run}
	                process_templates | $ssh_command "kubectl apply -f -"
		done
                if [[ "$struts_demo_attacker" == "1" ]]
		then
			template_file=${_templ_addons_loc}/struts_demo/attacker_install.yml.tmpl
                        process_templates | $ssh_command "kubectl apply -f -"
			sleep 60
                        # NOTE: [a-Z0-9] is a reversed/invalid bracket range; fixed to [a-zA-Z0-9]
                        # (same issue as install_insecure_app).
                        _pod_name=`$ssh_command "kubectl get pods -n ${struts_demo_ns:-struts} | grep -o '${struts_demo_name:-struts}-[a-z0-9]*-[a-zA-Z0-9]*'"`
                        $ssh_command "kubectl exec -n ${struts_demo_ns:-struts}  -i ${_pod_name} -- apk add --update --no-cache python3"


			template_file=${_templ_addons_loc}/struts_demo/attacker_install.yml.tmpl
                        process_templates | $ssh_command "kubectl apply -f -"
		fi
                echo "Struts demo app ( https://github.com/skywalke34/struts-demo ) should be available in a few seconds"
}



# load cluster vars
load_kclu_vars

# load rancher variables
load_rancher_vars

# load neuvector variables
load_nv_vars

# load Struts demo app variables
load_struts_demo_vars



# find a server node or API url
for _vm_name in $(jq -r '.nodes | to_entries[].key' < ${inputFile} |xargs)
do
	load_vm_vars
	ssh_command="ssh  -o StrictHostKeyChecking=accept-new -q  root@${_vm_name}"
	echo "# Using node: $_vm_name"
	setup_struts_demo
        _dns_entry="${struts_demo_name:-struts}.${clu_name}"
        add_service_dns
        echo "Service will be ready at http://${struts_demo_name:-struts}.${clu_name}.${mydomain}/super-app"
	sleep 60
	exit 1
	
done


