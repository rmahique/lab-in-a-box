#
# You should have received a copy of the GNU General Public License along with this program. If not, see <https://www.gnu.org/licenses/gpl-3.0.html>.
#
# JSON section: "trento" — configurable keys:
#   trento_version      : [OPTIONAL] Helm chart version (empty = latest, e.g. "2.4.0")
#   trento_ns           : [OPTIONAL] namespace (default: trento)
#   trento_shorthn      : [OPTIONAL] hostname prefix (default: trento)
#   trento_rel          : [OPTIONAL] Helm repo alias (default: trento)
#   trento_repo_url     : [OPTIONAL] Helm repo URL (default: https://trento-project.io/helm)
#   trento_admin        : [OPTIONAL] admin email (default: admin@lab.local)
#   trento_password     : [OPTIONAL] admin password (default: Trento12345)
#   trento_secret_key   : [OPTIONAL] secret key base for sessions (default: auto-generated)


_VERSION="__LABVERSION__"
[[ "${1}" == "--version" || "${1}" == "-v" ]] && echo "${0##*/} ${_VERSION}" && exit 0
if [[ "${1}" == "--validate" ]]; then
    _vf="${2}" _ve=0
    _vreq() { local _v; _v=$(jq -r ".${1}.${2} // \"\""  < "${_vf}" 2>/dev/null); [[ -n "${_v}" ]] || { echo "[ERROR] ${1}.${2} is required (no default)"; ((_ve++)); }; }
    _vns()  { local _v; _v=$(jq -r ".${1}.${1}_ns // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[a-z0-9][a-z0-9-]{0,62}$' || { echo "[ERROR] ${1}.${1}_ns='${_v}': invalid namespace (lowercase, alphanumeric, hyphens only)"; ((_ve++)); }; }
    _vver() { local _v; _v=$(jq -r ".${1}.${1}_version // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+\.[0-9]' || { echo "[ERROR] ${1}.${1}_version='${_v}': not a valid version (expected X.Y…)"; ((_ve++)); }; }
    _vurl() { local _v; _v=$(jq -r ".${1}.${1}_repo_url // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^https?://' || { echo "[ERROR] ${1}.${1}_repo_url='${_v}': must start with https://"; ((_ve++)); }; }
    _vbool(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" || "${_v}" == "true" || "${_v}" == "false" ]] || { echo "[ERROR] ${1}.${2}='${_v}': must be 'true' or 'false'"; ((_ve++)); }; }
    _vport(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+$' || { echo "[ERROR] ${1}.${2}='${_v}': must be a port number"; ((_ve++)); }; }
    _vns trento; _vver trento; _vurl trento
    exit ${_ve}
fi

if [[ "${1}" == "--help" ]]; then
    echo "Usage: ${0##*/} <lab.json> [<vm_name>]"
    echo ""
    awk '/# (─+ *)?JSON section:/{p=1} p && /^[^#]/{exit} p{sub(/^# ?/,""); print}' "$0"
    exit 0
fi
if [[ "${1}" == "--input-definition" || "${1}" == "--schema" ]]; then
    lab_schema "$0" "${2:-json}"
    exit $?
fi


# load lab_creation defaults
if [[ -f /etc/lab_creation.defaults ]]
then
        . /etc/lab_creation.defaults
elif [[ -f lab_creation.defaults ]]
then
        . lab_creation.defaults
else
        echo "ERROR: Configuration file lab_creation.defaults not found in local path or /etc"
        exit 1
fi

# Load primary functions
. ${_primary_funtions} || exit 1

# load Kubernetes functions
. ${_lib_path}/k8s_functions.bash


# Setup Trento Helm repo
function setup_trento_repo() {
        _repo_name="${trento_rel:-trento}"
        _repo_url="${trento_repo_url:-https://trento-project.io/helm}"
        helm_repo_add
}

# Install Trento
function setup_trento() {
        _ver="${trento_version:+--version ${trento_version}}"
        _fqdn="${trento_shorthn:-trento}.${clu_name}.${mydomain}"
        _secret="${trento_secret_key:-$(openssl rand -hex 32 2>/dev/null || echo 'changeme-generate-a-real-secret')}"
        $ssh_command "helm upgrade -i trento ${trento_rel:-trento}/trento-server \
                --namespace ${trento_ns:-trento} \
                --create-namespace \
                --set trento-web.adminUser.email=${trento_admin:-admin@lab.local} \
                --set trento-web.adminUser.password=${trento_password:-Trento12345} \
                --set trento-web.secretKeyBase=${_secret} \
                --set trento-web.ingress.enabled=true \
                --set trento-web.ingress.host=${_fqdn} \
                ${_ver}"
        echo "Trento available at: http://${_fqdn}  (${trento_admin:-admin@lab.local} / ${trento_password:-Trento12345})"
}


# load cluster and product vars
load_kclu_vars
load_trento_vars

on_first_server setup_helm setup_trento_repo setup_trento
