#!/bin/bash
# Part of lab-in-a-box, it will install a Google Gemini AI proxy (LiteLLM)
# Author/s: Raul Mahiques
# License: GPLv3
#
#  This program is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, either version 3 of the License, or (at your option) any later version.
#
# This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for more details.
#
# You should have received a copy of the GNU General Public License along with this program. If not, see <https://www.gnu.org/licenses/gpl-3.0.html>.
#
# JSON section: "gemini" — configurable keys:
#   gemini_api_key      : [MANDATORY] Google Gemini API key (from https://aistudio.google.com)
#   gemini_model        : [OPTIONAL] default Gemini model (default: gemini/gemini-1.5-flash)
#                         Examples: gemini/gemini-1.5-pro, gemini/gemini-2.0-flash
#   gemini_version      : [OPTIONAL] LiteLLM Helm chart version (empty = latest)
#   gemini_ns           : [OPTIONAL] namespace (default: gemini)
#   gemini_shorthn      : [OPTIONAL] hostname prefix (default: gemini)
#   gemini_rel          : [OPTIONAL] Helm repo alias (default: litellm)
#   gemini_repo_url     : [OPTIONAL] Helm repo URL (default: https://berriai.github.io/litellm)
#
# This script deploys LiteLLM as an OpenAI-compatible proxy for Google Gemini.
# The proxy exposes the same API as OpenAI so any OpenAI SDK can reach Gemini models.


_VERSION="__LABVERSION__"
[[ "${1}" == "--version" || "${1}" == "-v" ]] && echo "${0##*/} ${_VERSION}" && exit 0
if [[ "${1}" == "--validate" ]]; then
    _vf="${2}" _ve=0
    _vreq() { local _v; _v=$(jq -r ".${1}.${2} // \"\""  < "${_vf}" 2>/dev/null); [[ -n "${_v}" ]] || { echo "[ERROR] ${1}.${2} is required (no default)"; ((_ve++)); }; }
    _vns()  { local _v; _v=$(jq -r ".${1}.${1}_ns // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[a-z0-9][a-z0-9-]{0,62}$' || { echo "[ERROR] ${1}.${1}_ns='${_v}': invalid namespace (lowercase, alphanumeric, hyphens only)"; ((_ve++)); }; }
    _vver() { local _v; _v=$(jq -r ".${1}.${1}_version // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+\.[0-9]' || { echo "[ERROR] ${1}.${1}_version='${_v}': not a valid version (expected X.Y…)"; ((_ve++)); }; }
    _vurl() { local _v; _v=$(jq -r ".${1}.${1}_repo_url // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^https?://' || { echo "[ERROR] ${1}.${1}_repo_url='${_v}': must start with https://"; ((_ve++)); }; }
    _vbool(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" || "${_v}" == "true" || "${_v}" == "false" ]] || { echo "[ERROR] ${1}.${2}='${_v}': must be 'true' or 'false'"; ((_ve++)); }; }
    _vport(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+$' || { echo "[ERROR] ${1}.${2}='${_v}': must be a port number"; ((_ve++)); }; }
    _vreq gemini gemini_api_key
    _vns gemini; _vver gemini
    exit ${_ve}
fi

if [[ "${1}" == "--help" ]]; then
    echo "Usage: ${0##*/} <lab.json> [<vm_name>]"
    echo ""
    awk '/# (─+ *)?JSON section:/{p=1} p && /^[^#]/{exit} p{sub(/^# ?/,""); print}' "$0"
    exit 0
fi
if [[ "${1}" == "--input-definition" || "${1}" == "--schema" ]]; then
    lab_schema "$0" "${2:-json}"
    exit $?
fi


# load lab_creation defaults
if [[ -f /etc/lab_creation.defaults ]]
then
        . /etc/lab_creation.defaults
elif [[ -f lab_creation.defaults ]]
then
        . lab_creation.defaults
else
        echo "ERROR: Configuration file lab_creation.defaults not found in local path or /etc"
        exit 1
fi

# Load primary functions
. ${_primary_funtions} || exit 1

# load Kubernetes functions
. ${_lib_path}/k8s_functions.bash


# Setup LiteLLM Helm repo (used as the Gemini proxy)
function setup_gemini_repo() {
        _repo_name="${gemini_rel:-litellm}"
        _repo_url="${gemini_repo_url:-https://berriai.github.io/litellm}"
        helm_repo_add
}

# Install LiteLLM configured for Google Gemini
function setup_gemini() {
        if [[ -z "${gemini_api_key}" ]]
        then
                echo "ERROR: gemini_api_key is mandatory. Get one at https://aistudio.google.com" >&2
                exit 1
        fi

        _ver="${gemini_version:+--version ${gemini_version}}"
        _fqdn="${gemini_shorthn:-gemini}.${clu_name}.${mydomain}"
        _model="${gemini_model:-gemini/gemini-1.5-flash}"

        $ssh_command "helm upgrade -i gemini-proxy ${gemini_rel:-litellm}/litellm-helm \
                --namespace ${gemini_ns:-gemini} \
                --create-namespace \
                --set proxy_config.model_list[0].model_name=gemini \
                --set proxy_config.model_list[0].litellm_params.model=${_model} \
                --set proxy_config.model_list[0].litellm_params.api_key=${gemini_api_key} \
                --set ingress.enabled=true \
                --set ingress.host=${_fqdn} \
                ${_ver}"

        echo "Gemini proxy (LiteLLM) installed. Namespace: ${gemini_ns:-gemini}"
        echo "OpenAI-compatible endpoint: http://${_fqdn}/v1"
        echo "Default model: ${_model}"
        echo "Usage: curl http://${_fqdn}/v1/chat/completions -H 'Authorization: Bearer sk-anything' ..."
}


# load cluster and product vars
load_kclu_vars
load_gemini_vars

on_first_server setup_helm setup_gemini_repo setup_gemini
