#!/bin/bash
# Part of lab-in-a-box, it will install Uyuni server on a dedicated host VM
# Author/s: Raul Mahiques
# License: GPLv3
#
#  This program is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, either version 3 of the License, or (at your option) any later version.
#
# This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for more details.
#
# You should have received a copy of the GNU General Public License along with this program. If not, see <https://www.gnu.org/licenses/gpl-3.0.html>.
#
# Uyuni is an open-source systems management solution (upstream of SUSE Manager).
# This script installs it on a dedicated host VM using mgradm (container-based install).
# The target VM must run openSUSE Leap 15.6 / SLE Micro with podman available.
#
# JSON section: "uyuni" — configurable keys:
#   uyuni_admin         : [OPTIONAL] admin username (default: admin)
#   uyuni_password      : [OPTIONAL] admin password (default: Uyuni12345)
#   uyuni_email         : [OPTIONAL] admin email (default: admin@lab.local)
#   uyuni_org           : [OPTIONAL] default organisation name (default: lab)
#   uyuni_ssl_password  : [OPTIONAL] SSL certificate password (default: same as uyuni_password)
#   uyuni_channels      : [OPTIONAL] space-separated list of channels to sync after install
#   uyuni_extra_dsk     : [OPTIONAL] extra disk to mount for storage (e.g. /dev/vdb,/srv/mirror)
#
# The target node must have "uyuni" in its addons[] list in the JSON definition:
#   "nodes": { "uyuni.lab": { "myip": "...", "addons": ["uyuni"] } }


_VERSION="__LABVERSION__"
[[ "${1}" == "--version" || "${1}" == "-v" ]] && echo "${0##*/} ${_VERSION}" && exit 0
if [[ "${1}" == "--validate" ]]; then
    _vf="${2}" _ve=0
    _vreq() { local _v; _v=$(jq -r ".${1}.${2} // \"\""  < "${_vf}" 2>/dev/null); [[ -n "${_v}" ]] || { echo "[ERROR] ${1}.${2} is required (no default)"; ((_ve++)); }; }
    _vns()  { local _v; _v=$(jq -r ".${1}.${1}_ns // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[a-z0-9][a-z0-9-]{0,62}$' || { echo "[ERROR] ${1}.${1}_ns='${_v}': invalid namespace (lowercase, alphanumeric, hyphens only)"; ((_ve++)); }; }
    _vver() { local _v; _v=$(jq -r ".${1}.${1}_version // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+\.[0-9]' || { echo "[ERROR] ${1}.${1}_version='${_v}': not a valid version (expected X.Y…)"; ((_ve++)); }; }
    _vurl() { local _v; _v=$(jq -r ".${1}.${1}_repo_url // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^https?://' || { echo "[ERROR] ${1}.${1}_repo_url='${_v}': must start with https://"; ((_ve++)); }; }
    _vbool(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" || "${_v}" == "true" || "${_v}" == "false" ]] || { echo "[ERROR] ${1}.${2}='${_v}': must be 'true' or 'false'"; ((_ve++)); }; }
    _vport(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+$' || { echo "[ERROR] ${1}.${2}='${_v}': must be a port number"; ((_ve++)); }; }
    exit ${_ve}
fi

if [[ "${1}" == "--help" ]]; then
    echo "Usage: ${0##*/} <lab.json> [<vm_name>]"
    echo ""
    awk '/# (─+ *)?JSON section:/{p=1} p && /^[^#]/{exit} p{sub(/^# ?/,""); print}' "$0"
    exit 0
fi
if [[ "${1}" == "--input-definition" || "${1}" == "--schema" ]]; then
    lab_schema "$0" "${2:-json}"
    exit $?
fi


# load lab_creation defaults
if [[ -f /etc/lab_creation.defaults ]]
then
        . /etc/lab_creation.defaults
elif [[ -f lab_creation.defaults ]]
then
        . lab_creation.defaults
else
        echo "ERROR: Configuration file lab_creation.defaults not found in local path or /etc"
        exit 1
fi

# Load primary functions
. ${_primary_funtions} || exit 1


# Install Uyuni on a host VM
function setup_uyuni() {
        _msg="- Installing mgradm tooling" show_nicer_messages
        $ssh_command "transactional-update --quiet pkg install -y mgradm mgradm-bash-completion mgrctl mgrctl-bash-completion"
        reboot_vm
        sleep 5
        check_ssh_conn

        if [[ -n "${uyuni_extra_dsk}" ]]
        then
                for _dsk in ${uyuni_extra_dsk}
                do
                        _msg="- Mounting extra disk ${_dsk}" show_nicer_messages
                        $ssh_command "echo '${_dsk%%,*} ${_dsk##*,} xfs defaults,nofail 1 2' >> /etc/fstab"
                done
                reboot_vm
                sleep 5
                check_ssh_conn
        fi

        _msg="- Installing Uyuni server" show_nicer_messages
        $ssh_command "mgradm install podman \
                --admin-login ${uyuni_admin:-admin} \
                --admin-password ${uyuni_password:-Uyuni12345} \
                --admin-email ${uyuni_email:-admin@lab.local} \
                --ssl-password ${uyuni_ssl_password:-${uyuni_password:-Uyuni12345}} \
                --organization ${uyuni_org:-lab}"

        sleep 60
        $ssh_command "reboot"
        sleep 5
        check_ssh_conn

        _msg="Uyuni available at: https://${_vm_name}  (${uyuni_admin:-admin} / ${uyuni_password:-Uyuni12345})" show_nicer_messages

        if [[ -n "${uyuni_channels}" ]]
        then
                _count=0
                _msg="- Waiting for channel list to sync" show_nicer_messages
                while true
                do
                        sleep 10
                        ((_count+=1))
                        printf "Retry %d\r" "${_count}"
                        $ssh_command "mgrctl exec -- mgr-sync list channels 2>/dev/null" | grep -iv 'No channels found.' && break
                done
                sleep 300
                $ssh_command "mgrctl exec -- mgr-sync add channels ${uyuni_channels}"
        fi
}


# load uyuni variables
load_uyuni_vars

# run on node(s) with addon "uyuni" in their addons list, or on $_vm_name if pre-set
_addon=uyuni
on_addon_nodes setup_uyuni
