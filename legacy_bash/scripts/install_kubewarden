#
# JSON section: "kubewarden" — configurable keys:
#   kubewarden_version  : [OPTIONAL] Helm chart version (empty = latest, e.g. "2.0.0")
#   kubewarden_ns       : [OPTIONAL] namespace (default: kubewarden)
#   kubewarden_rel      : [OPTIONAL] Helm repo alias (default: kubewarden)
#   kubewarden_repo_url : [OPTIONAL] Helm repo URL (default: https://charts.kubewarden.io)


_VERSION="__LABVERSION__"
[[ "${1}" == "--version" || "${1}" == "-v" ]] && echo "${0##*/} ${_VERSION}" && exit 0
if [[ "${1}" == "--validate" ]]; then
    _vf="${2}" _ve=0
    _vreq() { local _v; _v=$(jq -r ".${1}.${2} // \"\""  < "${_vf}" 2>/dev/null); [[ -n "${_v}" ]] || { echo "[ERROR] ${1}.${2} is required (no default)"; ((_ve++)); }; }
    _vns()  { local _v; _v=$(jq -r ".${1}.${1}_ns // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[a-z0-9][a-z0-9-]{0,62}$' || { echo "[ERROR] ${1}.${1}_ns='${_v}': invalid namespace (lowercase, alphanumeric, hyphens only)"; ((_ve++)); }; }
    _vver() { local _v; _v=$(jq -r ".${1}.${1}_version // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+\.[0-9]' || { echo "[ERROR] ${1}.${1}_version='${_v}': not a valid version (expected X.Y…)"; ((_ve++)); }; }
    _vurl() { local _v; _v=$(jq -r ".${1}.${1}_repo_url // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^https?://' || { echo "[ERROR] ${1}.${1}_repo_url='${_v}': must start with https://"; ((_ve++)); }; }
    _vbool(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" || "${_v}" == "true" || "${_v}" == "false" ]] || { echo "[ERROR] ${1}.${2}='${_v}': must be 'true' or 'false'"; ((_ve++)); }; }
    _vport(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+$' || { echo "[ERROR] ${1}.${2}='${_v}': must be a port number"; ((_ve++)); }; }
    _vns kubewarden; _vver kubewarden; _vurl kubewarden
    exit ${_ve}
fi

if [[ "${1}" == "--help" ]]; then
    echo "Usage: ${0##*/} <lab.json> [<vm_name>]"
    echo ""
    awk '/# (─+ *)?JSON section:/{p=1} p && /^[^#]/{exit} p{sub(/^# ?/,""); print}' "$0"
    exit 0
fi
if [[ "${1}" == "--input-definition" || "${1}" == "--schema" ]]; then
    lab_schema "$0" "${2:-json}"
    exit $?
fi


# load lab_creation defaults
if [[ -f /etc/lab_creation.defaults ]]
then
        . /etc/lab_creation.defaults
elif [[ -f lab_creation.defaults ]]
then
        . lab_creation.defaults
else
        echo "ERROR: Configuration file lab_creation.defaults not found in local path or /etc"
        exit 1
fi

# Load primary functions
. ${_primary_funtions} || exit 1

# load Kubernetes functions
. ${_lib_path}/k8s_functions.bash


# Setup Kubewarden Helm repo
function setup_kubewarden_repo() {
        _repo_name="${kubewarden_rel:-kubewarden}"
        _repo_url="${kubewarden_repo_url:-https://charts.kubewarden.io}"
        helm_repo_add
}

# Install Kubewarden (crds → controller → defaults)
function setup_kubewarden() {
        _ver="${kubewarden_version:+--version ${kubewarden_version}}"

        echo "# Installing Kubewarden CRDs"
        $ssh_command "helm upgrade -i kubewarden-crds ${kubewarden_rel:-kubewarden}/kubewarden-crds \
                --namespace ${kubewarden_ns:-kubewarden} \
                --create-namespace \
                --wait \
                ${_ver}"

        echo "# Installing Kubewarden controller"
        $ssh_command "helm upgrade -i kubewarden-controller ${kubewarden_rel:-kubewarden}/kubewarden-controller \
                --namespace ${kubewarden_ns:-kubewarden} \
                --wait \
                ${_ver}"

        echo "# Installing Kubewarden defaults (recommended policies)"
        $ssh_command "helm upgrade -i kubewarden-defaults ${kubewarden_rel:-kubewarden}/kubewarden-defaults \
                --namespace ${kubewarden_ns:-kubewarden} \
                ${_ver}"

        echo "Kubewarden installed. Namespace: ${kubewarden_ns:-kubewarden}"
}


# load cluster and product vars
load_kclu_vars
load_kubewarden_vars

on_first_server setup_helm setup_kubewarden_repo setup_kubewarden
