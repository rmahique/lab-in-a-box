#
# You should have received a copy of the GNU General Public License along with this program. If not, see <https://www.gnu.org/licenses/gpl-3.0.html>.
#
# JSON section: "harbor" — configurable keys:
#   harbor_version       : [OPTIONAL] Helm chart version (empty = latest, e.g. "1.15.0")
#   harbor_ns            : [OPTIONAL] namespace (default: harbor)
#   harbor_shorthn       : [OPTIONAL] hostname prefix (default: harbor)
#   harbor_rel           : [OPTIONAL] Helm repo alias (default: harbor)
#   harbor_repo_url      : [OPTIONAL] Helm repo URL (default: https://helm.goharbor.io)
#   harbor_admin_password: [OPTIONAL] admin password (default: Harbor12345)


_VERSION="__LABVERSION__"
[[ "${1}" == "--version" || "${1}" == "-v" ]] && echo "${0##*/} ${_VERSION}" && exit 0
if [[ "${1}" == "--validate" ]]; then
    _vf="${2}" _ve=0
    _vreq() { local _v; _v=$(jq -r ".${1}.${2} // \"\""  < "${_vf}" 2>/dev/null); [[ -n "${_v}" ]] || { echo "[ERROR] ${1}.${2} is required (no default)"; ((_ve++)); }; }
    _vns()  { local _v; _v=$(jq -r ".${1}.${1}_ns // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[a-z0-9][a-z0-9-]{0,62}$' || { echo "[ERROR] ${1}.${1}_ns='${_v}': invalid namespace (lowercase, alphanumeric, hyphens only)"; ((_ve++)); }; }
    _vver() { local _v; _v=$(jq -r ".${1}.${1}_version // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+\.[0-9]' || { echo "[ERROR] ${1}.${1}_version='${_v}': not a valid version (expected X.Y…)"; ((_ve++)); }; }
    _vurl() { local _v; _v=$(jq -r ".${1}.${1}_repo_url // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^https?://' || { echo "[ERROR] ${1}.${1}_repo_url='${_v}': must start with https://"; ((_ve++)); }; }
    _vbool(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" || "${_v}" == "true" || "${_v}" == "false" ]] || { echo "[ERROR] ${1}.${2}='${_v}': must be 'true' or 'false'"; ((_ve++)); }; }
    _vport(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+$' || { echo "[ERROR] ${1}.${2}='${_v}': must be a port number"; ((_ve++)); }; }
    _vns harbor; _vver harbor; _vurl harbor
    exit ${_ve}
fi

if [[ "${1}" == "--help" ]]; then
    echo "Usage: ${0##*/} <lab.json> [<vm_name>]"
    echo ""
    awk '/# (─+ *)?JSON section:/{p=1} p && /^[^#]/{exit} p{sub(/^# ?/,""); print}' "$0"
    exit 0
fi
if [[ "${1}" == "--input-definition" || "${1}" == "--schema" ]]; then
    lab_schema "$0" "${2:-json}"
    exit $?
fi


# load lab_creation defaults
if [[ -f /etc/lab_creation.defaults ]]
then
        . /etc/lab_creation.defaults
elif [[ -f lab_creation.defaults ]]
then
        . lab_creation.defaults
else
        echo "ERROR: Configuration file lab_creation.defaults not found in local path or /etc"
        exit 1
fi

# Load primary functions
. ${_primary_funtions} || exit 1

# load Kubernetes functions
. ${_lib_path}/k8s_functions.bash


# Setup Harbor Helm repo
function setup_harbor_repo() {
        _repo_name="${harbor_rel:-harbor}"
        _repo_url="${harbor_repo_url:-https://helm.goharbor.io}"
        helm_repo_add
}

# Install Harbor
function setup_harbor() {
        _ver="${harbor_version:+--version ${harbor_version}}"
        _fqdn="${harbor_shorthn:-harbor}.${clu_name}.${mydomain}"
        $ssh_command "helm upgrade -i harbor ${harbor_rel:-harbor}/harbor \
                --namespace ${harbor_ns:-harbor} \
                --create-namespace \
                --set expose.type=ingress \
                --set expose.ingress.hosts.core=${_fqdn} \
                --set expose.tls.enabled=false \
                --set externalURL=http://${_fqdn} \
                --set harborAdminPassword=${harbor_admin_password:-Harbor12345} \
                ${_ver}"
        echo "Harbor available at: http://${_fqdn}  (admin / ${harbor_admin_password:-Harbor12345})"
}


# load cluster and product vars
load_kclu_vars
load_harbor_vars

on_first_server setup_helm setup_harbor_repo setup_harbor
