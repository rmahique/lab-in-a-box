_VERSION="__LABVERSION__"
# JSON section: "rancher" — SUSE Rancher Prime Kubernetes management platform
#
#   rancher_shorthn        : [OPTIONAL] Short hostname for UI ingress         (default: rancher)
#   rancher_rel            : [OPTIONAL] Helm repo alias                       (default: rancher-prime)
#   rancher_repo_url       : [OPTIONAL] Helm repo URL                         (default: https://charts.rancher.com/server-charts/prime)
#   rancher_helm_rel       : [OPTIONAL] Helm release name                     (default: rancher)
#   rancher_helm_chart     : [OPTIONAL] Helm chart reference                  (default: rancher-prime/rancher)
#   rancher_version        : [OPTIONAL] Helm chart version flag               (empty = latest, e.g. --version 2.13.3)
#   rancher_initial_pwd    : [OPTIONAL] Bootstrap admin password              (default: auto-generated)
#   rancher_replicas       : [OPTIONAL] Number of Rancher replicas            (default: 2)
#   rancher_cert_repo_name : [OPTIONAL] cert-manager Helm repo alias          (default: jetstack)
#   rancher_cert_repo_url  : [OPTIONAL] cert-manager Helm repo URL            (default: https://charts.jetstack.io)
#   cert_manager_ver       : [OPTIONAL] cert-manager version flag             (empty = latest, e.g. --version v1.14.4)

[[ "${1}" == "--version" || "${1}" == "-v" ]] && echo "${0##*/} ${_VERSION}" && exit 0
if [[ "${1}" == "--validate" ]]; then
    _vf="${2}" _ve=0
    _vreq() { local _v; _v=$(jq -r ".${1}.${2} // \"\""  < "${_vf}" 2>/dev/null); [[ -n "${_v}" ]] || { echo "[ERROR] ${1}.${2} is required (no default)"; ((_ve++)); }; }
    _vns()  { local _v; _v=$(jq -r ".${1}.${1}_ns // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[a-z0-9][a-z0-9-]{0,62}$' || { echo "[ERROR] ${1}.${1}_ns='${_v}': invalid namespace (lowercase, alphanumeric, hyphens only)"; ((_ve++)); }; }
    _vver() { local _v; _v=$(jq -r ".${1}.${1}_version // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+\.[0-9]' || { echo "[ERROR] ${1}.${1}_version='${_v}': not a valid version (expected X.Y…)"; ((_ve++)); }; }
    _vurl() { local _v; _v=$(jq -r ".${1}.${1}_repo_url // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^https?://' || { echo "[ERROR] ${1}.${1}_repo_url='${_v}': must start with https://"; ((_ve++)); }; }
    _vbool(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" || "${_v}" == "true" || "${_v}" == "false" ]] || { echo "[ERROR] ${1}.${2}='${_v}': must be 'true' or 'false'"; ((_ve++)); }; }
    _vport(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+$' || { echo "[ERROR] ${1}.${2}='${_v}': must be a port number"; ((_ve++)); }; }
    _vns rancher; _vver rancher; _vurl rancher
    exit ${_ve}
fi

if [[ "${1}" == "--help" ]]; then
    echo "Usage: ${0##*/} <lab.json> [<vm_name>]"
    echo ""
    awk '/# (─+ *)?JSON section:/{p=1} p && /^[^#]/{exit} p{sub(/^# ?/,""); print}' "$0"
    exit 0
fi
if [[ "${1}" == "--input-definition" || "${1}" == "--schema" ]]; then
    lab_schema "$0" "${2:-json}"
    exit $?
fi


# load lab_creation defaults
if [[ -f /etc/lab_creation.defaults ]]
then
        . /etc/lab_creation.defaults
elif [[ -f lab_creation.defaults ]]
then
        . lab_creation.defaults
else
        echo "ERROR: Configuration file lab_creation.defaults not found in local path or /etc"
        exit 1
fi

# Load primary functions
. ${_primary_funtions} || exit 1

# load Kubernetes functions
. ${_lib_path}/k8s_functions.bash || exit 1

# Setup SUSE Rancher helm respoitory
function setup_rancher_repo() {
        _repo_name="${rancher_rel:-rancher-stable/rancher}"
        _repo_url="${rancher_repo_url:-https://releases.rancher.com/server-charts/stable}"
        helm_repo_add

        _repo_name="${rancher_cert_repo_name:-jetstack}"
        _repo_url="${rancher_cert_repo_url:-https://charts.jetstack.io}"
        helm_repo_add
} 


# Setup cert-manager
function setup_cert-manager() {
        # https://cert-manager.io/docs/installation/helm/
        _msg="# Setup Cert-manager" show_nicer_messages

        local _install_cert_manager="helm upgrade -i cert-manager jetstack/cert-manager ${cert_manager_ver} --namespace cert-manager --create-namespace --set installCRDs=true"
        $ssh_command "${_install_cert_manager}" || _msg="$ssh_command \"${_install_cert_manager}\"" fail_with_error
        $ssh_command "kubectl wait pods -n cert-manager -l app.kubernetes.io/instance=cert-manager --for condition=Ready --timeout=120s 2>/dev/null"
        $ssh_command "kubectl apply -f -" <<EOF
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-ci
spec:
  acme:
    server: https://acme-staging-v02.api.letsencrypt.org/directory
    email: none@someunknowndomain.com
    privateKeySecretRef:
      name: letsencrypt-staging
    solvers:
      - http01:
          ingress:
            class: ${ingressClassname:-traefik}
...
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-prod
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    email: none@someunknowndomain.com
    privateKeySecretRef:
      name: letsencrypt-prod
    solvers:
      - http01:
          ingress:
            class: ${ingressClassname:-traefik}
EOF



}

 
# Setup SUSE Rancher
function setup_rancher() {
        msg="# Setup Rancher ${rancher_helm_rel:-rancher} in cluster \"${clu_name}\"" show_nicer_messages
#        $ssh_command "helm upgrade -i ${rancher_helm_rel:-rancher} ${rancher_helm_chart} --create-namespace --namespace cattle-system --set hostname=\"${rancher_shorthn}.${clu_name}.${mydomain}\" ${rancher_version} --set bootstrapPassword=\"${rancher_initial_pwd}\" --set replicas=${rancher_replicas:-2} --set ingress.extraAnnotations.'cert-manager\.io/cluster-issuer'=letsencrypt-prod --set ingress.tls.source=secret --set ingress.tls.secretName=tls-rancher --set agentTLSMode=\"system-store\"" || exit 1

        $ssh_command "helm upgrade -i ${rancher_helm_rel:-rancher} ${rancher_helm_chart} --create-namespace --namespace cattle-system --set hostname=\"${rancher_shorthn}.${clu_name}.${mydomain}\" ${rancher_version} --set bootstrapPassword=\"${rancher_initial_pwd}\" --set replicas=${rancher_replicas:-2} " || exit 1

        # verify it's up and running
        # kubectl -n cattle-system rollout status deploy/rancher
        # kubectl -n cattle-system get deploy rancher

        _msg="## Add Rancher DNS" show_nicer_messages
        _dns_entry="${rancher_shorthn:-ERROR_ranchershort}.${clu_name}"
        add_service_dns



        local clu_type_u="${clu_type^^}" 
        local matching_nodes
        matching_nodes=$(jq -r --arg ctype "INSTALL_${clu_type_u}_TYPE" --arg cname "${clu_name}" '
            .nodes | to_entries[] | select(.value[$ctype] == "server" and .value.kcluster == $cname) | .key
        ' < "${inputFile}")

        for _dns in $matching_nodes; do
            add_dns_to_named_rr
        done

        systemctl restart named

        _msg="Wait for rancher to be ready" show_nicer_messages
        $ssh_command 'kubectl wait pods -n cattle-system -l app=rancher --for condition=Ready --timeout=300s'
#        $ssh_command 'while ! kubectl get secret rancher-tls --namespace cattle-system 2>/dev/null; do sleep 1; done; sleep 10'
        sleep 60

        initial_rancher_pwd=$($ssh_command "kubectl get secret --namespace cattle-system bootstrap-secret -o jsonpath='{.data.bootstrapPassword}' | base64 -d") || { _msg="Failed to retrieve bootstrap secret" fail_with_error; }

        _msg="# Initial password: ${initial_rancher_pwd}" show_nicer_messages
#        initial_rancher_pwd=`$ssh_command "kubectl get secret --namespace cattle-system bootstrap-secret -o go-template='{{.data.bootstrapPassword|base64decode}}{{ \"\n\" }}'" || exit 1`

}



# load cluster vars
load_kclu_vars

# load rancher variables
load_rancher_vars


# find a server node or API url
load_vm_vars

ssh_command="ssh  -o StrictHostKeyChecking=accept-new -q  root@${_vm_name}"

if [[ "${INSTALL_RKE2_TYPE}" == "server" || "${INSTALL_RKE2_TYPE}" == "" ]]
then
	_msg="Using node: \e[1;91m\"${_vm_name}\"\e[0m" show_nicer_messages
	setup_helm
	_msg="Setup_rancher_repo" show_nicer_messages
	setup_rancher_repo
	setup_cert-manager
	setup_rancher
	exit 1
fi

