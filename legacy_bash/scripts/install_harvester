_VERSION="__LABVERSION__"
# JSON section: "harvester" — SUSE Virtualization (Harvester/KubeVirt) on Kubernetes
#   NOTE: section keys use the "virt_" prefix, not "harvester_".
#
#   virt_namespace  : [OPTIONAL] Kubernetes namespace                  (default: harvester-system)
#   virt_helm_rel   : [OPTIONAL] Helm release name                    (default: harvester)
#   virt_repo_name  : [OPTIONAL] Helm repo alias                      (default: harvester)
#   virt_repo_url   : [OPTIONAL] Helm repo URL                        (default: https://charts.harvesterhci.io)
#   virt_version    : [OPTIONAL] Helm chart version                   (empty = latest)
#   virt_replicas   : [OPTIONAL] Number of replicas                   (default: 1)

[[ "${1}" == "--version" || "${1}" == "-v" ]] && echo "${0##*/} ${_VERSION}" && exit 0
if [[ "${1}" == "--validate" ]]; then
    _vf="${2}" _ve=0
    _vreq() { local _v; _v=$(jq -r ".${1}.${2} // \"\""  < "${_vf}" 2>/dev/null); [[ -n "${_v}" ]] || { echo "[ERROR] ${1}.${2} is required (no default)"; ((_ve++)); }; }
    _vns()  { local _v; _v=$(jq -r ".${1}.${1}_ns // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[a-z0-9][a-z0-9-]{0,62}$' || { echo "[ERROR] ${1}.${1}_ns='${_v}': invalid namespace (lowercase, alphanumeric, hyphens only)"; ((_ve++)); }; }
    _vver() { local _v; _v=$(jq -r ".${1}.${1}_version // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+\.[0-9]' || { echo "[ERROR] ${1}.${1}_version='${_v}': not a valid version (expected X.Y…)"; ((_ve++)); }; }
    _vurl() { local _v; _v=$(jq -r ".${1}.${1}_repo_url // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^https?://' || { echo "[ERROR] ${1}.${1}_repo_url='${_v}': must start with https://"; ((_ve++)); }; }
    _vbool(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" || "${_v}" == "true" || "${_v}" == "false" ]] || { echo "[ERROR] ${1}.${2}='${_v}': must be 'true' or 'false'"; ((_ve++)); }; }
    _vport(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+$' || { echo "[ERROR] ${1}.${2}='${_v}': must be a port number"; ((_ve++)); }; }
    exit ${_ve}
fi

if [[ "${1}" == "--help" ]]; then
    echo "Usage: ${0##*/} <lab.json> [<vm_name>]"
    echo ""
    awk '/# (─+ *)?JSON section:/{p=1} p && /^[^#]/{exit} p{sub(/^# ?/,""); print}' "$0"
    exit 0
fi
if [[ "${1}" == "--input-definition" || "${1}" == "--schema" ]]; then
    lab_schema "$0" "${2:-json}"
    exit $?
fi


# load lab_creation defaults
if [[ -f /etc/lab_creation.defaults ]]
then
        . /etc/lab_creation.defaults
elif [[ -f lab_creation.defaults ]]
then
        . lab_creation.defaults
else
        echo "ERROR: Configuration file lab_creation.defaults not found in local path or /etc"
        exit 1
fi

# Load primary functions
. ${_primary_funtions} || exit 1

# load Kubernetes functions
. ${_lib_path}/k8s_functions.bash || exit 1







# Setup SUSE Virtualization (Harvester) Helm repository
setup_virt_repo() {
    # Relies on the global helm_repo_add function from your lib
    _repo_name="${virt_repo_name:-harvester}"
    _repo_url="${virt_repo_url:-https://charts.harvesterhci.io}"
    helm_repo_add
}

# Setup SUSE Virtualization 
setup_suse_virtualization() {
    _msg="# Setup SUSE Virtualization (${virt_helm_rel:-harvester}) in cluster \"${clu_name}\"" show_nicer_messages
    
    local virt_ns="${virt_namespace:-harvester-system}"
    local virt_chart_ver="${virt_version}" # e.g., --version 1.1.2 (leave empty for latest)

    # 1. Install Virtualization CRDs (Required before main chart)
    local crd_cmd="helm upgrade -i ${virt_helm_rel:-harvester}-crd ${_repo_name:-harvester}/harvester-crd --create-namespace --namespace '${virt_ns}' ${virt_chart_ver}"
    $ssh_command "$crd_cmd" || { _msg="Failed to install Virtualization CRDs" fail_with_error; }

    # 2. Install Main Virtualization Chart
    # Note: Harvester/KubeVirt can be heavy, so we pass necessary overrides here
    local helm_cmd="helm upgrade -i ${virt_helm_rel:-harvester} ${_repo_name:-harvester}/harvester --create-namespace --namespace '${virt_ns}' ${virt_chart_ver} --set replicas=${virt_replicas:-1}"
    $ssh_command "$helm_cmd" || { _msg="Failed to install Virtualization Chart" fail_with_error; }

    # 3. Wait for the Virtualization API and controllers to become ready
    _msg="Wait for SUSE Virtualization controllers to be ready" show_nicer_messages
    $ssh_command "kubectl wait pods -n '${virt_ns}' -l app.kubernetes.io/instance=${virt_helm_rel:-harvester} --for condition=Ready --timeout=300s 2>/dev/null"
    
    _msg="# SUSE Virtualization successfully deployed." show_nicer_messages
}




# load cluster vars
load_kclu_vars

# load rancher variables
# load_rancher_vars


# find a server node or API url
load_vm_vars

ssh_command="ssh  -o StrictHostKeyChecking=accept-new -q  root@${_vm_name}"

if [[ "${INSTALL_RKE2_TYPE}" == "server" || "${INSTALL_RKE2_TYPE}" == "" ]]
then
	_msg="Using node: \e[1;91m\"${_vm_name}\"\e[0m" show_nicer_messages
	setup_helm

        _msg="Setup_virt_repo" show_nicer_messages
        setup_virt_repo
        setup_suse_virtualization

	exit 1
fi

