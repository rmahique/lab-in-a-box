#!/bin/bash
# Part of lab-in-a-box, it will install PostgreSQL in Kubernetes (Helm) or on the OS
# Author/s: Raul Mahiques
# License: GPLv3
#
#  This program is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, either version 3 of the License, or (at your option) any later version.
#
# This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for more details.
#
# You should have received a copy of the GNU General Public License along with this program. If not, see <https://www.gnu.org/licenses/gpl-3.0.html>.
#
# ─── MODE DETECTION ────────────────────────────────────────────────────────────
#   Kubernetes mode : script is called as a kclusters addon → clu_name env var is set
#   OS mode         : script is called as a nodes addon     → clu_name env var is empty
#   Override either mode by setting postgresql_mode = "kubernetes" or "os" in the JSON.
#
# ─── JSON section: "postgresql" ────────────────────────────────────────────────
#
# SHARED (both modes)
#   postgresql_mode       : [OPTIONAL] "auto" (default), "kubernetes", or "os"
#   postgresql_password   : [OPTIONAL] superuser password       (default: postgres123)
#   postgresql_db         : [OPTIONAL] default database name    (default: postgres)
#   postgresql_user       : [OPTIONAL] default username         (default: postgres)
#
# KUBERNETES MODE
#   postgresql_version    : [OPTIONAL] Helm chart version       (empty = latest, e.g. "15.5.17")
#   postgresql_ns         : [OPTIONAL] namespace                (default: postgresql)
#   postgresql_rel        : [OPTIONAL] Helm repo alias          (default: bitnami)
#   postgresql_repo_url   : [OPTIONAL] Helm repo URL            (default: https://charts.bitnami.com/bitnami)
#
# OS MODE  — the target node must list "postgresql" in its nodes[x].addons[] array
#   postgresql_pg_version : [OPTIONAL] PostgreSQL major version (default: 16, e.g. "14", "15", "16")
#                           Setting a lower version than the distro default achieves a downgrade.
#   postgresql_port       : [OPTIONAL] listening port           (default: 5432)
#   postgresql_listen     : [OPTIONAL] listen_addresses value   (default: *)
#
# SLES / SLE Micro note:
#   On SLES 15, the postgresql packages live in the "Server Applications Module".
#   Activate it first:  SUSEConnect -p sle-module-server-applications/15.6/x86_64
#   SLE Micro uses transactional-update and requires a reboot after package install.
#
# RHEL / CentOS note:
#   The official PGDG repository (yum.postgresql.org) is added automatically so that
#   any supported major version (including older ones) can be installed.
#
# Ubuntu / Debian note:
#   The official PGDG APT repository (apt.postgresql.org) is added automatically.


_VERSION="__LABVERSION__"
[[ "${1}" == "--version" || "${1}" == "-v" ]] && echo "${0##*/} ${_VERSION}" && exit 0
if [[ "${1}" == "--validate" ]]; then
    _vf="${2}" _ve=0
    _vreq() { local _v; _v=$(jq -r ".${1}.${2} // \"\""  < "${_vf}" 2>/dev/null); [[ -n "${_v}" ]] || { echo "[ERROR] ${1}.${2} is required (no default)"; ((_ve++)); }; }
    _vns()  { local _v; _v=$(jq -r ".${1}.${1}_ns // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[a-z0-9][a-z0-9-]{0,62}$' || { echo "[ERROR] ${1}.${1}_ns='${_v}': invalid namespace (lowercase, alphanumeric, hyphens only)"; ((_ve++)); }; }
    _vver() { local _v; _v=$(jq -r ".${1}.${1}_version // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+\.[0-9]' || { echo "[ERROR] ${1}.${1}_version='${_v}': not a valid version (expected X.Y…)"; ((_ve++)); }; }
    _vurl() { local _v; _v=$(jq -r ".${1}.${1}_repo_url // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^https?://' || { echo "[ERROR] ${1}.${1}_repo_url='${_v}': must start with https://"; ((_ve++)); }; }
    _vbool(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" || "${_v}" == "true" || "${_v}" == "false" ]] || { echo "[ERROR] ${1}.${2}='${_v}': must be 'true' or 'false'"; ((_ve++)); }; }
    _vport(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+$' || { echo "[ERROR] ${1}.${2}='${_v}': must be a port number"; ((_ve++)); }; }
    _mode=$(jq -r '.postgresql.postgresql_mode // ""' < "${_vf}" 2>/dev/null)
    [[ -z "${_mode}" || "${_mode}" == "auto" || "${_mode}" == "kubernetes" || "${_mode}" == "os" ]] || \
        { echo "[ERROR] postgresql.postgresql_mode='${_mode}': must be auto, kubernetes, or os"; ((_ve++)); }
    _pgver=$(jq -r '.postgresql.postgresql_pg_version // ""' < "${_vf}" 2>/dev/null)
    [[ -z "${_pgver}" ]] || echo "${_pgver}" | grep -qE '^[0-9]+$' || \
        { echo "[ERROR] postgresql.postgresql_pg_version='${_pgver}': must be a major version number (e.g. 16)"; ((_ve++)); }
    _vport postgresql postgresql_port
    _vns postgresql; _vver postgresql
    exit ${_ve}
fi

if [[ "${1}" == "--help" ]]; then
    echo "Usage: ${0##*/} <lab.json> [<vm_name>]"
    echo ""
    awk '/# (─+ *)?JSON section:/{p=1} p && /^[^#]/{exit} p{sub(/^# ?/,""); print}' "$0"
    exit 0
fi
if [[ "${1}" == "--input-definition" || "${1}" == "--schema" ]]; then
    lab_schema "$0" "${2:-json}"
    exit $?
fi


# load lab_creation defaults
if [[ -f /etc/lab_creation.defaults ]]
then
        . /etc/lab_creation.defaults
elif [[ -f lab_creation.defaults ]]
then
        . lab_creation.defaults
else
        echo "ERROR: Configuration file lab_creation.defaults not found in local path or /etc"
        exit 1
fi

# Load primary functions
. ${_primary_funtions} || exit 1

# load Kubernetes functions
. ${_lib_path}/k8s_functions.bash


# ─── Kubernetes (Helm) mode ────────────────────────────────────────────────────

function setup_postgresql_repo() {
        _repo_name="${postgresql_rel:-bitnami}"
        _repo_url="${postgresql_repo_url:-https://charts.bitnami.com/bitnami}"
        helm_repo_add
}

function setup_postgresql_k8s() {
        _ver="${postgresql_version:+--version ${postgresql_version}}"
        $ssh_command "helm upgrade -i postgresql ${postgresql_rel:-bitnami}/postgresql \
                --namespace ${postgresql_ns:-postgresql} \
                --create-namespace \
                --set auth.postgresPassword=${postgresql_password:-postgres123} \
                --set auth.database=${postgresql_db:-postgres} \
                --set auth.username=${postgresql_user:-postgres} \
                ${_ver}"
        echo "PostgreSQL installed in Kubernetes. Namespace: ${postgresql_ns:-postgresql}"
        echo "Connect: kubectl -n ${postgresql_ns:-postgresql} exec -it postgresql-0 -- psql -U ${postgresql_user:-postgres}"
}


# ─── OS mode — helpers ─────────────────────────────────────────────────────────

# Detect the remote OS family and version; sets _os_id, _os_ver_id, _os_like
function _pg_detect_os() {
        _os_raw=$($ssh_command \
                "source /etc/os-release 2>/dev/null && printf '%s|%s|%s' \"\${ID}\" \"\${VERSION_ID}\" \"\${ID_LIKE:-}\"")
        _os_id="${_os_raw%%|*}"
        _os_rest="${_os_raw#*|}"
        _os_ver_id="${_os_rest%%|*}"
        _os_like="${_os_rest##*|}"
        # Normalise version to major integer for numeric comparisons
        _os_ver_major="${_os_ver_id%%.*}"
        _os_ver_minor="${_os_ver_id#*.}"; _os_ver_minor="${_os_ver_minor%%.*}"
        echo "# Detected remote OS: id=${_os_id} version=${_os_ver_id} like=${_os_like}"
}

# Common post-install: set password, configure pg_hba and listen_addresses
function _pg_configure_os() {
        _pw="${postgresql_password:-postgres123}"
        _listen="${postgresql_listen:-*}"
        _port="${postgresql_port:-5432}"

        _msg="- Configuring PostgreSQL (password, listen_addresses, pg_hba)" show_nicer_messages

        # Find the active data directory on the remote node
        _pgdata=$($ssh_command "su - postgres -s /bin/bash -c 'psql -t -c \"SHOW data_directory;\"' 2>/dev/null | tr -d ' \n'" 2>/dev/null || echo "")
        [[ -z "${_pgdata}" ]] && _pgdata="/var/lib/pgsql/data"

        # Set superuser password
        echo "ALTER USER postgres PASSWORD '${_pw}';" | \
                $ssh_command "su - postgres -s /bin/bash -c 'psql'" 2>/dev/null || \
                $ssh_command "sudo -u postgres psql -c \"ALTER USER postgres PASSWORD '${_pw}';\"" 2>/dev/null

        # Create default DB and user if different from postgres/postgres
        if [[ "${postgresql_db:-postgres}" != "postgres" ]]
        then
                $ssh_command "sudo -u postgres psql -c \"CREATE DATABASE ${postgresql_db:-postgres};\"" 2>/dev/null || true
        fi
        if [[ "${postgresql_user:-postgres}" != "postgres" ]]
        then
                $ssh_command "sudo -u postgres psql -c \"CREATE USER ${postgresql_user:-postgres} WITH PASSWORD '${_pw}';\"" 2>/dev/null || true
                $ssh_command "sudo -u postgres psql -c \"GRANT ALL PRIVILEGES ON DATABASE ${postgresql_db:-postgres} TO ${postgresql_user:-postgres};\"" 2>/dev/null || true
        fi

        # Allow password auth and remote connections
        $ssh_command "
if [[ -f '${_pgdata}/postgresql.conf' ]]; then
    sed -i \"s|^#*listen_addresses.*|listen_addresses = '${_listen}'|\" '${_pgdata}/postgresql.conf'
    sed -i \"s|^#*port.*|port = ${_port}|\" '${_pgdata}/postgresql.conf'
fi
if [[ -f '${_pgdata}/pg_hba.conf' ]]; then
    grep -q 'host all all 0.0.0.0/0 md5' '${_pgdata}/pg_hba.conf' || \
        echo 'host all all 0.0.0.0/0 md5' >> '${_pgdata}/pg_hba.conf'
fi"

        $ssh_command "systemctl restart postgresql.service 2>/dev/null || \
                      systemctl restart postgresql-${_pg_ver}.service 2>/dev/null || true"

        echo "PostgreSQL installed on ${_vm_name}:${_port}"
        echo "Connect: psql -h ${_vm_name} -U ${postgresql_user:-postgres} -d ${postgresql_db:-postgres}"
}


# ─── OS mode — SUSE family (zypper) ───────────────────────────────────────────

function _pg_install_suse() {
        _pg_ver="${postgresql_pg_version:-16}"
        _msg="- Installing PostgreSQL ${_pg_ver} on ${_vm_name} (SUSE/openSUSE)" show_nicer_messages

        # Try version-specific package; fall back to unversioned (distro default)
        $ssh_command "zypper install -y --no-confirm postgresql${_pg_ver}-server postgresql${_pg_ver} 2>&1" || \
        $ssh_command "zypper install -y --no-confirm postgresql-server postgresql 2>&1" || {
                echo "ERROR: Could not install PostgreSQL via zypper. On SLES, ensure the" >&2
                echo "       'Server Applications Module' is activated:" >&2
                echo "       SUSEConnect -p sle-module-server-applications/${_os_ver_id}/x86_64" >&2
                exit 1
        }

        # initdb if needed (openSUSE sometimes skips this)
        $ssh_command "
if [[ ! -f /var/lib/pgsql/data/PG_VERSION ]]; then
    su - postgres -s /bin/bash -c 'initdb -D /var/lib/pgsql/data' 2>/dev/null || \
    postgresql${_pg_ver}-setup initdb 2>/dev/null || \
    postgresql-setup --initdb 2>/dev/null || true
fi"

        $ssh_command "systemctl enable --now postgresql.service 2>/dev/null || \
                      systemctl enable --now postgresql-${_pg_ver}.service 2>/dev/null || true"
        _pg_configure_os
}


# ─── OS mode — SLE Micro (transactional-update, requires reboot) ──────────────

function _pg_install_slemicro() {
        _pg_ver="${postgresql_pg_version:-16}"
        _msg="- Installing PostgreSQL ${_pg_ver} on ${_vm_name} (SLE Micro — transactional)" show_nicer_messages

        $ssh_command "transactional-update --quiet pkg install -y postgresql${_pg_ver}-server postgresql${_pg_ver} 2>&1" || \
        $ssh_command "transactional-update --quiet pkg install -y postgresql-server postgresql 2>&1" || {
                echo "ERROR: Could not install PostgreSQL via transactional-update." >&2
                exit 1
        }

        _msg="- Rebooting ${_vm_name} to activate transactional changes" show_nicer_messages
        reboot_vm
        sleep 5
        check_ssh_conn

        $ssh_command "
if [[ ! -f /var/lib/pgsql/data/PG_VERSION ]]; then
    su - postgres -s /bin/bash -c 'initdb -D /var/lib/pgsql/data' 2>/dev/null || \
    postgresql${_pg_ver}-setup initdb 2>/dev/null || true
fi"

        $ssh_command "systemctl enable --now postgresql.service 2>/dev/null || \
                      systemctl enable --now postgresql-${_pg_ver}.service 2>/dev/null || true"
        _pg_configure_os
}


# ─── OS mode — RHEL/CentOS/Rocky/Alma family (yum/dnf + PGDG repo) ────────────

function _pg_install_rhel() {
        _pg_ver="${postgresql_pg_version:-16}"
        _msg="- Installing PostgreSQL ${_pg_ver} on ${_vm_name} (RHEL/CentOS family)" show_nicer_messages

        # Detect package manager and EL major version
        _el_ver="${_os_ver_major}"
        # NOTE: was `command -v dnf 2>/dev/null && echo dnf || echo yum` — 2>/dev/null only
        # silences stderr, but `command -v` prints the found path to STDOUT, so when dnf
        # exists this captured "/usr/bin/dnf\ndnf" (two lines) instead of just "dnf",
        # corrupting every later ${_pkg_mgr} invocation. Fixed to also redirect stdout.
        _pkg_mgr=$($ssh_command "command -v dnf >/dev/null 2>&1 && echo dnf || echo yum")

        # Add the official PostgreSQL PGDG repository (provides all supported versions)
        _pgdg_rpm="https://download.postgresql.org/pub/repos/yum/reporpms/EL-${_el_ver}-x86_64/pgdg-redhat-repo-latest.noarch.rpm"
        $ssh_command "${_pkg_mgr} install -y ${_pgdg_rpm} 2>&1 || true"

        # On RHEL/CentOS 8+ the AppStream postgresql module conflicts; disable it
        if [[ "${_el_ver}" -ge 8 ]]
        then
                $ssh_command "${_pkg_mgr} -qy module disable postgresql 2>/dev/null || true"
        fi

        # Install version-specific package
        $ssh_command "${_pkg_mgr} install -y postgresql${_pg_ver}-server 2>&1" || {
                echo "ERROR: Could not install postgresql${_pg_ver}-server. Check PGDG repo availability." >&2
                exit 1
        }

        # initdb and enable
        $ssh_command "/usr/pgsql-${_pg_ver}/bin/postgresql-${_pg_ver}-setup initdb 2>/dev/null || \
                      postgresql${_pg_ver}-setup initdb 2>/dev/null || true"
        $ssh_command "systemctl enable --now postgresql-${_pg_ver}.service"

        # Open firewall port if firewalld is running
        $ssh_command "
if systemctl is-active firewalld &>/dev/null; then
    firewall-cmd --permanent --add-port=${postgresql_port:-5432}/tcp
    firewall-cmd --reload
fi"

        _pg_configure_os
}


# ─── OS mode — Ubuntu/Debian family (apt + PGDG repo) ─────────────────────────

function _pg_install_debian() {
        _pg_ver="${postgresql_pg_version:-16}"
        _msg="- Installing PostgreSQL ${_pg_ver} on ${_vm_name} (Ubuntu/Debian family)" show_nicer_messages

        # Add the official PostgreSQL PGDG APT repository
        $ssh_command "
export DEBIAN_FRONTEND=noninteractive
apt-get install -y curl ca-certificates lsb-release gnupg 2>&1
install -d /usr/share/postgresql-common/pgdg
curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc
echo \"deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] \
    https://apt.postgresql.org/pub/repos/apt \$(lsb_release -cs)-pgdg main\" \
    > /etc/apt/sources.list.d/pgdg.list
apt-get update -qq"

        $ssh_command "DEBIAN_FRONTEND=noninteractive apt-get install -y postgresql-${_pg_ver} 2>&1" || {
                echo "ERROR: Could not install postgresql-${_pg_ver}. Check PGDG repo availability." >&2
                exit 1
        }

        # Open firewall port if ufw is active
        $ssh_command "
if command -v ufw &>/dev/null && ufw status | grep -q 'Status: active'; then
    ufw allow ${postgresql_port:-5432}/tcp
fi"

        _pg_configure_os
}


# ─── OS mode — dispatcher ─────────────────────────────────────────────────────

function setup_postgresql_os() {
        _pg_detect_os

        case "${_os_id}" in
                sle-micro|slemicro)
                        _pg_install_slemicro ;;

                sles|suse)
                        _pg_install_suse ;;

                opensuse-leap|opensuse-tumbleweed|opensuse*)
                        _pg_install_suse ;;

                rhel|centos|rocky|almalinux|ol|scientific|fedora)
                        _pg_install_rhel ;;

                ubuntu|debian|linuxmint|pop|raspbian)
                        _pg_install_debian ;;

                *)
                        # Fall back on ID_LIKE if the primary ID is not recognised
                        if echo "${_os_like}" | grep -qi "suse"
                        then
                                _pg_install_suse
                        elif echo "${_os_like}" | grep -qi "rhel\|fedora\|centos"
                        then
                                _pg_install_rhel
                        elif echo "${_os_like}" | grep -qi "debian"
                        then
                                _pg_install_debian
                        else
                                echo "ERROR: Unsupported OS '${_os_id}' (ID_LIKE='${_os_like}')." >&2
                                echo "       Supported families: SUSE/openSUSE, RHEL/CentOS, Ubuntu/Debian." >&2
                                exit 1
                        fi ;;
        esac
}


# ─── Main ──────────────────────────────────────────────────────────────────────

load_postgresql_vars

# Determine install mode:
#   1. Explicit override via postgresql_mode in JSON
#   2. Auto-detect: clu_name set → kubernetes; clu_name empty → os
_mode="${postgresql_mode:-auto}"
if [[ "${_mode}" == "auto" ]]
then
        [[ -n "${clu_name}" ]] && _mode="kubernetes" || _mode="os"
fi

if [[ "${_mode}" == "kubernetes" ]]
then
        load_kclu_vars
        on_first_server setup_helm setup_postgresql_repo setup_postgresql_k8s
else
        _addon=postgresql
        on_addon_nodes setup_postgresql_os
fi
